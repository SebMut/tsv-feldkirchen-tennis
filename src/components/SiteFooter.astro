---
import { COURTBOOKING_URL, mediaUrl } from '../lib/supabase';

const IMPRESSUM_URL = 'https://tsvfeldkirchen.de/impressum';
const STATUTES_URL = 'https://tsvfeldkirchen.de/satzung';
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <img class="footer-logo" src={mediaUrl('branding/tennis-logo.png')} alt="TSV Feldkirchen Tennis" />
      <div><strong>TSV Feldkirchen Tennis</strong>
      <p>Olympiastrasse 1 · 85622 Feldkirchen</p>
      <p><a href="mailto:tennis@tsvfeldkirchen.de">tennis@tsvfeldkirchen.de</a> · <a href="tel:+49899036460">+49 (0) 89 903 64 60</a></p></div>
    </div>
    <div class="footer-links">
      <a href={COURTBOOKING_URL} target="_blank" rel="noreferrer">Courtbooking ↗</a>
      <a href="/funktionaere/">Funktionäre</a>
      <a href="/sponsoren/">Sponsoren</a>
      <a href="/kontakt/">Kontakt</a>
      <a href="/hallenplaetze/">Hallenfinder</a>
      <a href={`${import.meta.env.BASE_URL}admin/`}>Administration</a>
      <a href={IMPRESSUM_URL} target="_blank" rel="noreferrer">Impressum ↗</a>
      <a href="/datenschutz/">Datenschutz</a>
      <a href={STATUTES_URL} target="_blank" rel="noreferrer">Satzung ↗</a>
    </div>
  </div>
  <div class="container footer-credit">
    <span>Entwickelt und gehostet von</span>
    <a href="https://smartwerk.art/" target="_blank" rel="noopener noreferrer" aria-label="SmartWerk.art – Website öffnen">
      <img src="/images/smartwerk-art-logo.png" width="299" height="57" loading="lazy" alt="SmartWerk.art 3D Druck" />
    </a>
  </div>
</footer>
