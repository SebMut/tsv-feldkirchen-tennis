---
import { COURTBOOKING_URL, mediaUrl } from '../lib/supabase';

interface Props {
  variant?: 'dark' | 'light';
}
const { variant = 'dark' } = Astro.props;
const base = import.meta.env.BASE_URL;
const pathname = Astro.url.pathname;
const route = base !== '/' && pathname.startsWith(base) ? '/' + pathname.slice(base.length) : pathname;
const active = (href: string) => href === '/' ? route === '/' : route.startsWith(href);
const activePlay = active('/spieltag/') || active('/spiel/');
const activeMore = !activePlay && !active('/aktuelles/') && !active('/training/') && !active('/termine/');
---
<header class:list={['site-header', { 'site-header--light': variant === 'light' }]}>
  <div class="container site-header__inner">
    <a class="brand" href="/" aria-label="TSV Feldkirchen Tennis Startseite">
      <img class="brand__logo" src={mediaUrl('branding/tennis-logo.png')} alt="TSV Feldkirchen Tennis" />
      <span><strong>TSV Feldkirchen</strong><small>Tennis</small></span>
    </a>
    <nav class="desktop-nav" aria-label="Hauptnavigation">
      <a href="/aktuelles/">Aktuelles</a>
      <a href="/mannschaften/">Mannschaften</a>
      <a href="/training/">Training</a>
      <a href="/termine/">Kalender</a>
      <a href="/spieltag/">Live-Ticker</a>
      <a href="/ueber-uns/">Über uns</a>
      <a href="/mitglied-werden/">Mitglied werden</a>
      <a class="nav-booking" href={COURTBOOKING_URL} target="_blank" rel="noreferrer">Platz buchen ↗</a>
      <a href="/admin/" data-auth-link>Login</a>
    </nav>
    <details class="mobile-nav">
      <summary aria-label="Menü öffnen">Menü</summary>
      <div>
        <a href="/aktuelles/">Aktuelles</a>
        <a href="/mannschaften/">Mannschaften</a>
        <a href="/training/">Training</a>
        <a href="/termine/">Kalender</a>
        <a href="/spieltag/">Live-Ticker</a>
        <a href="/ueber-uns/">Über uns</a>
        <a href="/mitglied-werden/">Mitglied werden</a>
        <a href="/sponsoren/">Sponsoren</a>
        <a href={COURTBOOKING_URL} target="_blank" rel="noreferrer">Platz buchen ↗</a>
        <a href="/admin/" data-auth-link>Login</a>
      </div>
    </details>
  </div>
</header>

<!-- Mobile dock: quick access to live ticker, news, training and calendar. -->
<nav class="mobile-dock" aria-label="Mobile Hauptnavigation">
  <a class:list={['mobile-dock__tab', { 'is-active': activePlay }]} href="/spieltag/" aria-current={activePlay ? 'page' : undefined}>
    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h3l3-7 4 14 3-7h3"/><circle cx="20" cy="4" r="1.5" fill="currentColor" stroke="none"/></svg>
    <span>Live-Ticker</span>
  </a>
  <a class:list={['mobile-dock__tab', { 'is-active': active('/aktuelles/') }]} href="/aktuelles/" aria-current={active('/aktuelles/') ? 'page' : undefined}>
    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 7h8M8 11h8M8 15h5"/></svg>
    <span>Aktuelles</span>
  </a>
  <a class:list={['mobile-dock__tab', { 'is-active': active('/training/') }]} href="/training/" aria-current={active('/training/') ? 'page' : undefined}>
    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8"/><path d="M6.4 6.4c3.3 3.5 7.9 7.9 11.2 11.2M6.4 17.6c3.5-3.3 7.9-7.9 11.2-11.2"/></svg>
    <span>Training</span>
  </a>
  <a class:list={['mobile-dock__tab', { 'is-active': active('/termine/') }]} href="/termine/" aria-current={active('/termine/') ? 'page' : undefined}>
    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v4m10-4v4M3 10h18m-13 4h3m-3 4h3"/></svg>
    <span>Kalender</span>
  </a>
  <details class="mobile-dock__more">
    <summary class:list={['mobile-dock__tab', { 'is-active': activeMore }]} aria-label="Weitere Seiten öffnen">
      <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
      <span>Mehr</span>
    </summary>
    <div class="mobile-dock__panel" aria-label="Weitere Menüpunkte">
      <strong>Weitere Seiten</strong>
      <a href="/">Startseite <span>›</span></a>
      <a href="/mannschaften/">Mannschaften <span>›</span></a>
      <a href="/ueber-uns/">Über uns <span>›</span></a>
      <a href="/mitglied-werden/">Mitglied werden <span>›</span></a>
      <a href="/sponsoren/">Sponsoren <span>›</span></a>
      <a href="/kontakt/">Kontakt <span>›</span></a>
      <a href={COURTBOOKING_URL} target="_blank" rel="noopener noreferrer">Platz buchen <span>↗</span></a>
      <a href="/admin/" data-auth-link>Login</a>
    </div>
  </details>
</nav>

<script>
  import { supabase } from '../lib/supabase';

  const authLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-auth-link]'));

  // Keep the native <details> menu keyboard friendly and dismiss it on outside taps.
  const dockMore = document.querySelector<HTMLDetailsElement>('.mobile-dock__more');
  document.addEventListener('pointerdown', (event) => {
    if (dockMore?.open && event.target instanceof Node && !dockMore.contains(event.target)) dockMore.open = false;
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && dockMore?.open) {
      dockMore.open = false;
      dockMore.querySelector<HTMLElement>('summary')?.focus();
    }
  });

  function updateAuthLinks(signedIn: boolean) {
    authLinks.forEach((link) => {
      link.textContent = signedIn ? 'Logout' : 'Login';
      link.href = signedIn ? '#' : `${import.meta.env.BASE_URL}admin/`;
      link.onclick = signedIn
        ? async (event) => {
            event.preventDefault();
            await supabase.auth.signOut();
            window.location.href = import.meta.env.BASE_URL || '/';
          }
        : null;
    });
  }

  supabase.auth.getSession().then(({ data }) => {
    updateAuthLinks(!!data.session);
  });

  supabase.auth.onAuthStateChange((_event, session) => {
    updateAuthLinks(!!session);
  });
</script>
