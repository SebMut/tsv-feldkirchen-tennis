---
import MainLayout from '../../layouts/MainLayout.astro';
---
<MainLayout title="Mein TSV | TSV Feldkirchen Tennis" description="Geschützter Bereich für Mannschaften und SuperAdmins." noindex={true}>
  <div class="container stack admin-workspace" id="admin-root">
    <section id="auth-box" class="card admin-auth-card">
      <p class="eyebrow">Mein TSV</p>
      <h1>Login</h1>
      <p class="muted">Mannschaftsverantwortliche und Administratoren melden sich hier an.</p>
      <div id="auth-status" class="notice hidden" aria-live="polite"></div>
      <form id="login-form" class="form-grid">
        <div class="field"><label for="login-email">E-Mail</label><input id="login-email" name="email" type="email" autocomplete="email" required /></div>
        <div class="field"><label for="login-password">Passwort</label><input id="login-password" name="password" type="password" autocomplete="current-password" required /></div>
        <div class="field full"><button class="button" type="submit">Anmelden</button></div>
      </form>
      <details class="auth-help">
        <summary>Passwort vergessen?</summary>
        <form id="password-reset-form" class="form-grid">
          <div class="field"><label for="reset-email">E-Mail</label><input id="reset-email" type="email" autocomplete="email" required /></div>
          <div class="field"><button class="button secondary" type="submit">Link zum Zurücksetzen senden</button></div>
        </form>
      </details>
      <p class="muted">Neue Mannschaftsnutzer werden ausschließlich durch den SuperAdmin eingeladen.</p>
    </section>

    <section id="password-setup-box" class="card admin-auth-card hidden">
      <p class="eyebrow">Mein TSV</p>
      <h1>Passwort festlegen</h1>
      <p class="muted">Bevor du den geschützten Bereich verwenden kannst, lege bitte dein persönliches Passwort fest.</p>
      <div id="password-setup-status" class="notice hidden" aria-live="polite"></div>
      <form id="password-setup-form" class="form-grid">
        <div class="field">
          <label for="setup-password">Neues Passwort</label>
          <input id="setup-password" type="password" minlength="12" autocomplete="new-password" required />
          <p class="muted">Mindestens 12 Zeichen. Verwende ein Passwort, das du nicht bei anderen Diensten nutzt.</p>
        </div>
        <div class="field">
          <label for="setup-password-confirm">Passwort wiederholen</label>
          <input id="setup-password-confirm" type="password" minlength="12" autocomplete="new-password" required />
          <p class="muted form-helper-spacer" aria-hidden="true">Mindestens 12 Zeichen. Verwende ein Passwort, das du nicht bei anderen Diensten nutzt.</p>
        </div>
        <div class="field full"><button class="button" type="submit">Passwort speichern und weiter</button></div>
      </form>
    </section>

    <section id="admin-app" class="hidden">
      <header class="admin-workspace-head">
        <div>
          <p class="eyebrow">Mein TSV <span aria-hidden="true">/</span> Verwaltungsbereich</p>
          <h1 id="admin-title">Übersicht</h1>
          <p id="admin-section-description" class="muted">Dein Überblick über Mannschaften, Spiele und Aufgaben.</p>
        </div>
        <div class="admin-workspace-head__actions">
          <span id="admin-userline" class="admin-userline"></span>
          <a class="admin-public-link" href={import.meta.env.BASE_URL} target="_blank" rel="noopener noreferrer">Website ansehen <span aria-hidden="true">↗</span></a>
          <button id="admin-logout" class="admin-public-link admin-logout-button" type="button">Abmelden</button>
        </div>
      </header>
      <div id="admin-status" class="notice hidden" aria-live="polite"></div>

      <div class="admin-shell">
        <nav class="card admin-nav" aria-label="Administration">
          <div class="admin-nav__brand"><span class="admin-nav__brand-mark" aria-hidden="true">TSV</span><span>Mein TSV<small>Arbeitsbereich</small></span></div>
          <div class="admin-nav__group" data-admin-nav-group="start">
            <p class="admin-nav__label">Start</p>
            <button type="button" data-panel="dashboard" class="active" aria-current="page"><span aria-hidden="true" class="admin-nav__symbol">▦</span> Übersicht</button>
          </div>
          <div class="admin-nav__group" data-admin-nav-group="spielbetrieb">
            <p class="admin-nav__label">Spielbetrieb</p>
            <button type="button" data-panel="matches" data-ticker-only><span aria-hidden="true" class="admin-nav__symbol">◉</span> Spiele &amp; Liveticker</button>
            <button type="button" data-panel="teams" data-editor-only><span aria-hidden="true" class="admin-nav__symbol">▤</span> Mannschaften</button>
            <button type="button" data-panel="players" data-editor-only><span aria-hidden="true" class="admin-nav__symbol">♙</span> Kader</button>
            <button type="button" data-panel="btv-import" data-super-only><span aria-hidden="true" class="admin-nav__symbol">↻</span> BTV-Spielplan</button>
            <button type="button" data-panel="manual-results" data-super-only class="hidden"><span aria-hidden="true" class="admin-nav__symbol">✓</span> Ergebnisse nachtragen</button>
            <button type="button" data-panel="official-rubbers" data-super-only class="hidden"><span aria-hidden="true" class="admin-nav__symbol">≡</span> Einzel &amp; Doppel 2026</button>
          </div>
          <div class="admin-nav__group" data-admin-nav-group="inhalte">
            <p class="admin-nav__label">Inhalte &amp; Verein</p>
            <button type="button" data-panel="news" data-editor-only><span aria-hidden="true" class="admin-nav__symbol">✎</span> News</button>
            <button type="button" data-panel="rsvp-events" data-super-only><span aria-hidden="true" class="admin-nav__symbol">✦</span> Veranstaltungen &amp; Zusagen</button>
            <button type="button" data-panel="galleries" data-editor-only><span aria-hidden="true" class="admin-nav__symbol">▧</span> Bilder</button>
            <button type="button" data-panel="content" data-super-only><span aria-hidden="true" class="admin-nav__symbol">☷</span> Website-Inhalte</button>
            <button type="button" data-panel="facility" data-super-only><span aria-hidden="true" class="admin-nav__symbol">⌂</span> Anlage</button>
          </div>
          <div class="admin-nav__group" data-admin-nav-group="verwaltung">
            <p class="admin-nav__label">Verwaltung</p>
            <button type="button" data-panel="seasons" data-super-only><span aria-hidden="true" class="admin-nav__symbol">◷</span> Saisons</button>
            <button type="button" data-panel="users" data-super-only><span aria-hidden="true" class="admin-nav__symbol">♧</span> Benutzer</button>
            <button type="button" data-panel="audit" data-super-only><span aria-hidden="true" class="admin-nav__symbol">↺</span> Änderungsverlauf</button>
            <button type="button" data-panel="settings" data-super-only><span aria-hidden="true" class="admin-nav__symbol">⚙</span> Einstellungen</button>
            <button type="button" data-panel="account"><span aria-hidden="true" class="admin-nav__symbol">◎</span> Mein Konto</button>
          </div>
        </nav>

        <div class="admin-main stack">
          <div class="admin-mobile-picker">
            <label for="admin-panel-select">Verwaltungsbereich wählen</label>
            <select id="admin-panel-select" aria-label="Verwaltungsbereich wählen"></select>
          </div>
          <section id="panel-dashboard" class="admin-panel active">
            <div class="admin-summary-grid" aria-label="Überblick">
              <div class="admin-summary-tile"><span>Verfügbare Mannschaften</span><strong id="admin-stat-teams">–</strong></div>
              <div class="admin-summary-tile"><span>Anstehende Spiele</span><strong id="admin-stat-upcoming">–</strong></div>
              <div class="admin-summary-tile"><span>Gerade live</span><strong id="admin-stat-live">–</strong></div>
            </div>
            <div id="dashboard-quickstart" class="card dashboard-quickstart">
              <p class="eyebrow">Direkt loslegen</p>
              <h2>Dein nächster Schritt</h2>
              <p class="muted">Spieltage und häufige Aufgaben ohne Umwege öffnen.</p>
              <div id="dashboard-live-action" aria-live="polite"></div>
              <div class="admin-shortcuts" aria-label="Schnellzugriff">
                <button class="admin-shortcut" type="button" data-admin-jump="matches" data-ticker-only><strong>Spiele &amp; Liveticker</strong><span>Spieltage bearbeiten <span aria-hidden="true">›</span></span></button>
                <button class="admin-shortcut" type="button" data-admin-jump="players" data-editor-only><strong>Kader pflegen</strong><span>Spieler verwalten <span aria-hidden="true">›</span></span></button>
                <button class="admin-shortcut" type="button" data-admin-jump="news" data-editor-only><strong>News erstellen</strong><span>Beiträge veröffentlichen <span aria-hidden="true">›</span></span></button>
                <button class="admin-shortcut hidden" type="button" data-admin-jump="manual-results" data-super-only><strong>Ergebnisse nachtragen</strong><span>Fehlende Ergebnisse <span aria-hidden="true">›</span></span></button>
              </div>
            </div>
            <div id="phase8-my-next" class="card phase8-my-next" aria-live="polite"><p class="eyebrow">Mein TSV</p><h2>Mein nächster Spieltag</h2><p class="muted">Deine Mannschaft und der nächste Spieltag werden geladen …</p></div>
            <div class="card admin-team-directory">
              <div class="admin-directory-head">
                <div><p class="eyebrow">Mannschaften</p><h2>Meine Mannschaften</h2><p class="muted">Passende Mannschaft finden und direkt bearbeiten.</p></div>
                <span id="dashboard-team-count" class="admin-directory-count" aria-live="polite"></span>
              </div>
              <div class="admin-team-filterbar">
                <div class="field">
                  <label for="dashboard-team-search">Mannschaft suchen</label>
                  <input id="dashboard-team-search" type="search" placeholder="z. B. Herren II oder Bambini" autocomplete="off" />
                </div>
                <div class="field">
                  <label for="dashboard-team-filter">Anzeigen</label>
                  <select id="dashboard-team-filter">
                    <option value="all">Alle Mannschaften</option>
                    <option value="upcoming">Mit anstehendem Spiel</option>
                    <option value="live">Gerade live</option>
                  </select>
                </div>
              </div>
              <p id="dashboard-team-empty" class="admin-directory-empty muted hidden" role="status">Keine Mannschaft passt zu deiner Suche. Prüfe den Suchbegriff oder ändere den Filter.</p>
              <div id="dashboard-teams" class="dashboard-team-grid"></div>
            </div>
          </section>


          <section id="panel-official-rubbers" class="admin-panel" data-super-only>
            <div class="card stack">
              <p class="eyebrow">SuperAdmin · Amtliche Spielberichte</p>
              <h2>Einzel &amp; Doppel · Sommer 2026</h2>
              <p class="muted">Nur tatsächlich aus offiziellen BTV-Spielberichten geprüfte Aufstellungen, Sätze und Match-Tiebreaks. Die Daten sind ausschließlich nach Anmeldung für berechtigte Administratoren sichtbar. Fehlende Spielberichte werden ausdrücklich gekennzeichnet.</p>
              <p id="btv-rubbers-summary" class="muted" aria-live="polite"></p>
              <div id="btv-rubbers-feedback" class="notice" aria-live="polite"></div>
              <div class="form-grid">
                <div class="field"><label for="btv-rubbers-team">Mannschaft</label><select id="btv-rubbers-team"><option value="all">Alle Mannschaften</option></select></div>
                <div class="field"><label for="btv-rubbers-search">Begegnung suchen</label><input id="btv-rubbers-search" type="search" placeholder="Gegner oder Mannschaft" /></div>
                <div class="field full"><label><input id="btv-rubbers-missing" type="checkbox" /> Nur Begegnungen mit fehlendem Spielbericht</label></div>
                <div class="field full"><button id="btv-rubbers-refresh" type="button" class="button secondary">Spielberichte aktualisieren</button></div>
              </div>
              <h3>Begegnungen (<span id="btv-rubbers-count">0</span>)</h3>
              <div id="btv-rubbers-list" class="stack"></div>
            </div>
            <div class="card stack" id="btv-rubbers-detail">
              <p class="muted">Wähle eine Begegnung.</p>
            </div>
          </section>

          <section id="panel-manual-results" class="admin-panel" data-super-only>
            <div class="card stack">
              <p class="eyebrow">SuperAdmin · Mannschaftsspiele</p>
              <h2>Ergebnisse nachtragen</h2>
              <p class="muted">Mannschaftsbegegnungen aus allen gespeicherten Saisons. Ergebnisse werden zunächst als <strong>manuell erfasst</strong> gespeichert und bleiben bis zum BTV-/tennis.de-Abgleich intern. Amtliche BTV-Werte und Liveticker bleiben unverändert.</p>
              <div id="manual-results-feedback" class="notice hidden" aria-live="polite"></div>
              <div class="form-grid">
                <div class="field"><label for="manual-results-season">Saison</label><select id="manual-results-season"></select></div>
                <div class="field"><label for="manual-results-search">Suche nach Heim, Gast oder Mannschaft</label><input id="manual-results-search" type="search" placeholder="Mannschaft oder Gegner" /></div>
                <div class="field full">
                  <label><input id="manual-results-open-only" type="checkbox" checked /> Nur noch nicht erfasste Spiele</label>
                  <p class="muted">Bereits manuell gespeicherte oder amtlich erfasste Begegnungen werden ausgeblendet. Häkchen entfernen, um alle Spiele und Nachträge anzuzeigen und zu bearbeiten.</p>
                </div>
                <div class="field full"><button id="manual-results-refresh" class="button secondary" type="button">Begegnungen neu laden</button></div>
              </div>
              <h3>Begegnungen (<span id="manual-results-count">0</span>)</h3>
              <div id="manual-results-list" class="manual-results-list" aria-live="polite"></div>
            </div>
            <div class="card stack">
              <h2>Ergebnis eingeben</h2>
              <p id="manual-results-empty" class="muted">Wähle oben eine Begegnung aus.</p>
              <form id="manual-result-form" class="form-grid hidden">
                <div class="field full"><h3 id="manual-results-selected"></h3><p id="manual-results-date" class="muted"></p><p id="manual-results-withdrawal" class="notice hidden" aria-live="polite"></p><a id="manual-result-official-link" class="text-link hidden" href="#" target="_blank" rel="noopener noreferrer">Offiziellen BTV-Spielplan öffnen →</a></div>
                <div class="field full">
                  <label for="manual-result-status">Spielstatus</label>
                  <select id="manual-result-status" required>
                    <option value="played">Regulär gespielt</option>
                    <option value="walkover">Kampflos / w.o.</option>
                    <option value="withdrawn">Zurückgezogen</option>
                    <option value="cancelled">Abgesagt</option>
                    <option value="abandoned">Abgebrochen</option>
                    <option value="postponed">Verschoben</option>
                    <option value="unknown">Wertung noch unklar</option>
                  </select>
                </div>
                <div class="field"><label for="manual-result-home">Heim-Punkte</label><input id="manual-result-home" type="number" min="0" max="99" step="1" inputmode="numeric" /></div>
                <div class="field"><label for="manual-result-away">Gast-Punkte</label><input id="manual-result-away" type="number" min="0" max="99" step="1" inputmode="numeric" /></div>
                <div class="field full"><p class="muted">Ergebnisse immer aus Sicht <strong>Heim : Gast</strong> eintragen. Bei Rückzug oder unklarer Wertung dürfen die Felder leer bleiben; ein reguläres 0:0 wird nicht akzeptiert.</p></div>
                <div class="field">
                  <label for="manual-result-source">Quelle</label>
                  <select id="manual-result-source">
                    <option value="club_confirmation">TSV / Mannschaftsführung</option>
                    <option value="btv_report">BTV / nuLiga</option>
                    <option value="tennis_de">tennis.de</option>
                    <option value="other">Sonstige Quelle</option>
                  </select>
                </div>
                <div class="field"><label for="manual-result-url">Link zum Spielbericht (optional)</label><input id="manual-result-url" type="url" maxlength="1000" placeholder="https://..." /></div>
                <div class="field full"><label for="manual-result-notes">Interne Anmerkung</label><textarea id="manual-result-notes" rows="3" maxlength="1200" placeholder="Nur fachliche Hinweise, keine privaten Jugendspielerdaten"></textarea></div>
                <div class="field full"><label><input id="manual-result-confirm" type="checkbox" required /> Heim/Gast, Spielstatus und Quelle sind geprüft.</label><p class="muted">Diese Bestätigung speichert noch nichts. Erst „Ergebnis manuell speichern“ schließt die Erfassung ab und entfernt das Spiel aus der Liste der nicht erfassten Begegnungen.</p></div>
                <div class="field full"><button class="button" id="manual-result-save" type="submit">Ergebnis manuell speichern</button></div>
              </form>
            </div>
          </section>

          <section id="panel-btv-import" class="admin-panel" data-super-only>
            <div class="card stack">
              <p class="eyebrow">Offizielle BTV-Quellen · TSV Feldkirchen (01012)</p>
              <h2>Automatischer BTV-Abgleich</h2>
              <p><strong>Offizielle Ergebnisse haben immer Vorrang.</strong> Ein manuell gepflegter Liveticker bleibt als Verlauf erhalten. Neue BTV-Endstände dürfen den öffentlichen Mannschaftsspielstand jederzeit korrigieren.</p>
              <p class="muted">Geplanter Rhythmus: alle sechs Stunden. Der Import wird über GitHub Actions auf dem Standardbranch ausgeführt, <strong>nur wenn die Importfreigabe aktiviert ist</strong>. Ein Link allein aktiviert noch keinen Import. Die offiziellen Quellen werden vor der Übernahme auf Mannschaft und Saison geprüft.</p>
              <section class="btv-source-editor" aria-labelledby="btv-source-editor-title">
                <div class="btv-source-editor__header">
                  <div>
                    <h3 id="btv-source-editor-title">Mannschafts-URLs pflegen</h3>
                    <p class="muted">Die Quellen sind je Saison getrennt. Verwende möglichst den direkten BTV-Gruppenlink mit <code>groupid=…</code>; eine Vereinsübersicht reicht für den zuverlässigen Einzelabgleich nicht aus.</p>
                  </div>
                  <label for="btv-source-season">Saison
                    <select id="btv-source-season"></select>
                  </label>
                </div>
                <div id="btv-source-summary" class="btv-source-editor__summary" aria-live="polite"></div>
                <div id="btv-source-list" class="btv-source-editor__list" aria-live="polite"></div>
                <p class="muted">Die Links werden in den bestehenden Mannschafts-Saisondaten gespeichert. Der aktuelle Import liest noch nur die bereits verifizierten BTV-Spielplandokumente; weitere Quellen müssen vor ihrer automatischen Auswertung angebunden werden.</p>
              </section>
              <div class="actions">
                <button class="button ghost" type="button" id="btv-sync-refresh">Status aktualisieren</button>
                <a class="button ghost" href="https://btv.liga.nu/cgi-bin/WebObjects/nuLigaDokumentTENDE.woa/wa/nuDokument?club=23391&amp;dokument=ScheduleReportFOP&amp;season=18105" target="_blank" rel="noopener noreferrer">BTV-Spielplan 2026 (PDF) öffnen</a>
              </div>
              <div id="btv-sync-status" aria-live="polite"><p class="muted">Importprotokoll wird geladen …</p></div>
              <h3>Erkannte Terminänderungen</h3>
              <div id="btv-sync-changes" aria-live="polite"></div>
            </div>
          </section>

          <section id="panel-audit" class="admin-panel">
            <div class="card">
              <p class="eyebrow">Sicherheit</p><h2>Änderungsverlauf</h2>
              <p class="muted">Zeigt die letzten 80 Änderungen an Spielständen, Tickermeldungen, Terminen, News und Anlagenstatus. Aus Datenschutzgründen werden keine früheren Nachrichteninhalte oder Spielerprofile gespeichert.</p>
              <button id="audit-refresh" class="button ghost" type="button">Aktualisieren</button>
              <div id="audit-list" class="table-wrap" aria-live="polite"><p class="muted">Änderungen werden geladen …</p></div>
            </div>
          </section>

          <section id="panel-teams" class="admin-panel">
            <div class="card">
              <h2>Mannschaft pflegen</h2>
              <div id="team-season-filter" class="admin-season-pills" aria-label="Saison auswählen">
                <button type="button" class="admin-season-pill is-active" data-team-season="sommer-2026" aria-pressed="true">Sommer 2026</button>
                <button type="button" class="admin-season-pill" data-team-season="winter-2026-2027" aria-pressed="false">Winter 2026/2027</button>
                <button type="button" class="admin-season-pill" data-team-season="sommer-2027" aria-pressed="false">Sommer 2027</button>
              </div>
              <form id="team-form" class="form-grid">
                <div class="field full"><label>Mannschaft / Saison</label><select id="team-select" required></select><p class="muted">Sommer, Winter und kommende Spielzeiten werden getrennt verwaltet.</p></div>
                <div class="field"><label>Mannschaftsname (saisonübergreifend)</label><input id="team-name" required /></div>
                <div class="field"><label>Kurzname (saisonübergreifend)</label><input id="team-short-name" /></div>
                <div class="field full"><label>Beschreibung (saisonübergreifend)</label><textarea id="team-description"></textarea></div>
                <div class="field"><label>Liga dieser Saison</label><input id="team-league" /></div>
                <div class="field"><label>Gruppe dieser Saison</label><input id="team-group" /></div>
                <div class="field full"><label>BTV-Link dieser Saison</label><input id="team-btv-url" type="url" /></div>
                <div class="field full">
                  <label>Mannschaftsbild dieser Saison</label>
                  <div id="team-image-preview" class="team-image-preview"></div>
                </div>
                <div class="field"><label>Neues Mannschaftsbild</label><input id="team-image" type="file" accept="image/jpeg,image/png,image/webp,image/avif" /></div>
                <div class="field"><button id="team-image-reset" class="button ghost" type="button">Saisonbild entfernen</button></div>
                <div class="field"><button class="button" type="submit">Mannschaft speichern</button></div>
              </form>
            </div>
          </section>

          <section id="panel-players" class="admin-panel">
            <div class="card">
              <h2>Kader</h2>
              <div id="roster-season-filter" class="admin-season-pills" aria-label="Kadersaison auswählen">
                <button type="button" class="admin-season-pill is-active" data-roster-season="sommer-2026" aria-pressed="true">Sommer 2026</button>
                <button type="button" class="admin-season-pill" data-roster-season="winter-2026-2027" aria-pressed="false">Winter 2026/2027</button>
                <button type="button" class="admin-season-pill" data-roster-season="sommer-2027" aria-pressed="false">Sommer 2027</button>
              </div>
              <div class="field"><label>Mannschaft / Saison</label><select id="players-team-season"></select></div>
              <p id="players-season-context" class="admin-season-context" aria-live="polite"></p>
              <form id="player-form" class="form-grid">
                <input id="player-edit-id" type="hidden" />
                <div class="field"><label>Anzeigename</label><input id="player-display-name" required /></div>
                <div class="field"><label>Foto</label><input id="player-photo" type="file" accept="image/jpeg,image/png,image/webp,image/avif" /></div>
                <div class="field"><label><input id="player-captain" type="checkbox" /> Mannschaftsführung</label></div>
                <div class="field"><label><input id="player-public-visible" type="checkbox" /> öffentlich im Kader anzeigen</label><p class="muted">Aus Datenschutzgründen bleiben neue Spieler zunächst intern.</p></div>
                <div class="field"><button id="player-submit" class="button" type="submit">Spieler hinzufügen</button></div>
                <div class="field"><button id="player-cancel-edit" class="button ghost hidden" type="button">Bearbeiten abbrechen</button></div>
              </form>
              <details class="roster-bulk-import">
                <summary>Namentliche Mannschaftsmeldung gesammelt übernehmen</summary>
