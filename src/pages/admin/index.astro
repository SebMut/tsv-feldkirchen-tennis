---
import MainLayout from '../../layouts/MainLayout.astro';
---
<MainLayout title="Mein TSV | TSV Feldkirchen Tennis" description="Geschützter Bereich für Mannschaften und SuperAdmins." noindex={true}>
  <div class="container stack" id="admin-root">
    <section id="auth-box" class="card">
      <p class="eyebrow">Mein TSV</p>
      <h1>Login</h1>
      <p class="muted">Mannschaftsverantwortliche und Administratoren melden sich hier an.</p>
      <div id="auth-status" class="notice hidden" aria-live="polite"></div>
      <form id="login-form" class="form-grid">
        <div class="field"><label for="login-email">E-Mail</label><input id="login-email" name="email" type="email" autocomplete="email" required /></div>
        <div class="field"><label for="login-password">Passwort</label><input id="login-password" name="password" type="password" autocomplete="current-password" required /></div>
        <div class="field full"><button class="button" type="submit">Anmelden</button></div>
      </form>
      <details>
        <summary>Ersteinrichtung des SuperAdmins</summary>
        <p class="muted">Nur für das erste Benutzerkonto des neuen Systems. Nach der ersten erfolgreichen Aktivierung ist diese Funktion gesperrt.</p>
        <form id="signup-form" class="form-grid">
          <div class="field"><label for="signup-name">Name</label><input id="signup-name" name="display_name" required /></div>
          <div class="field"><label for="signup-email">E-Mail</label><input id="signup-email" name="email" type="email" required /></div>
          <div class="field"><label for="signup-password">Passwort</label><input id="signup-password" name="password" type="password" minlength="10" required /></div>
          <div class="field"><button class="button secondary" type="submit">Erstkonto anlegen</button></div>
        </form>
      </details>
    </section>

    <section id="admin-app" class="hidden">
      <div class="page-head">
        <div><p class="eyebrow">Mein TSV</p><h1 id="admin-title">Administration</h1><p id="admin-userline" class="muted"></p></div>
        <div class="actions"><button id="bootstrap-button" class="button secondary hidden" type="button">SuperAdmin aktivieren</button><button id="logout-button" class="button ghost" type="button">Abmelden</button></div>
      </div>
      <div id="admin-status" class="notice hidden" aria-live="polite"></div>

      <div class="admin-shell">
        <nav class="card admin-nav" aria-label="Administration">
          <button data-panel="dashboard" class="active">Übersicht</button>
          <button data-panel="teams">Mannschaft</button>
          <button data-panel="players">Kader</button>
          <button data-panel="matches">Spiele & Liveticker</button>
          <button data-panel="news">News</button>
          <button data-panel="events">Termine</button>
          <button data-panel="galleries">Bilder</button>
          <button data-panel="facility" data-super-only>Anlage</button>
          <button data-panel="content" data-super-only>Website-Inhalte</button>
          <button data-panel="users" data-super-only>Benutzer</button>
          <button data-panel="account">Mein Konto</button>
        </nav>

        <div class="stack">
          <section id="panel-dashboard" class="admin-panel active"><div class="card"><h2>Meine Mannschaften</h2><div id="dashboard-teams" class="grid two"></div></div></section>

          <section id="panel-teams" class="admin-panel">
            <div class="card">
              <h2>Mannschaft pflegen</h2>
              <form id="team-form" class="form-grid">
                <div class="field full"><label>Mannschaft</label><select id="team-select" required></select></div>
                <div class="field"><label>Name</label><input id="team-name" required /></div>
                <div class="field"><label>Kurzname</label><input id="team-short-name" /></div>
                <div class="field full"><label>Beschreibung</label><textarea id="team-description"></textarea></div>
                <div class="field"><label>Liga</label><input id="team-league" /></div>
                <div class="field"><label>Gruppe</label><input id="team-group" /></div>
                <div class="field full"><label>BTV-Link</label><input id="team-btv-url" type="url" /></div>
                <div class="field"><label>Mannschaftsbild</label><input id="team-image" type="file" accept="image/jpeg,image/png,image/webp,image/avif" /></div>
                <div class="field"><button class="button" type="submit">Mannschaft speichern</button></div>
              </form>
            </div>
          </section>

          <section id="panel-players" class="admin-panel">
            <div class="card">
              <h2>Kader</h2>
              <div class="field"><label>Mannschaft / Saison</label><select id="players-team-season"></select></div>
              <form id="player-form" class="form-grid">
                <div class="field"><label>Anzeigename</label><input id="player-display-name" required /></div>
                <div class="field"><label>Foto</label><input id="player-photo" type="file" accept="image/jpeg,image/png,image/webp,image/avif" /></div>
                <div class="field"><label><input id="player-captain" type="checkbox" /> Mannschaftsführung</label></div>
                <div class="field"><button class="button" type="submit">Spieler hinzufügen</button></div>
              </form>
              <div id="players-list" class="table-wrap"></div>
            </div>
          </section>

          <section id="panel-matches" class="admin-panel">
            <div class="card">
              <h2>Spiel anlegen</h2>
              <form id="match-form" class="form-grid">
                <div class="field"><label>Mannschaft / Saison</label><select id="match-team-season" required></select></div>
                <div class="field"><label>Gegner</label><input id="match-opponent" required /></div>
                <div class="field"><label>Beginn</label><input id="match-start" type="datetime-local" required /></div>
                <div class="field"><label>Ende</label><input id="match-end" type="datetime-local" /></div>
                <div class="field"><label><input id="match-home" type="checkbox" checked /> Heimspiel</label></div>
                <div class="field"><label>BTV / externer Link</label><input id="match-url" type="url" /></div>
                <div class="field full"><button class="button" type="submit">Spiel speichern</button></div>
              </form>
            </div>
            <div class="card"><h2>Spiele & Liveticker</h2><div id="matches-admin-list" class="stack"></div></div>
          </section>

          <section id="panel-news" class="admin-panel">
            <div class="card">
              <h2>News / Spielbericht</h2>
              <form id="news-form" class="form-grid">
                <div class="field"><label>Mannschaft</label><select id="news-team"></select></div>
                <div class="field"><label>Bezug zu Spiel</label><select id="news-match"><option value="">Kein Spiel</option></select></div>
                <div class="field full"><label>Titel</label><input id="news-title" required /></div>
                <div class="field full"><label>Kurztext</label><textarea id="news-excerpt"></textarea></div>
                <div class="field full"><label>Text</label><textarea id="news-body" required></textarea></div>
                <div class="field"><label>Status</label><select id="news-status"><option value="published">Veröffentlicht</option><option value="draft">Entwurf</option></select></div>
                <div class="field"><button class="button" type="submit">Beitrag speichern</button></div>
              </form>
              <div id="news-admin-list" class="table-wrap"></div>
            </div>
          </section>

          <section id="panel-events" class="admin-panel">
            <div class="card">
              <h2>Veranstaltung</h2>
              <form id="event-form" class="form-grid">
                <div class="field"><label>Mannschaft optional</label><select id="event-team"></select></div>
                <div class="field"><label>Kategorie</label><input id="event-category" value="club" /></div>
                <div class="field full"><label>Titel</label><input id="event-title" required /></div>
                <div class="field"><label>Beginn</label><input id="event-start" type="datetime-local" required /></div>
                <div class="field"><label>Ende</label><input id="event-end" type="datetime-local" /></div>
                <div class="field full"><label>Beschreibung</label><textarea id="event-description"></textarea></div>
                <div class="field"><label>Ort</label><input id="event-location" /></div>
                <div class="field"><button class="button" type="submit">Termin speichern</button></div>
              </form>
              <div id="events-admin-list" class="table-wrap"></div>
            </div>
          </section>

          <section id="panel-galleries" class="admin-panel">
            <div class="card">
              <h2>Bildergalerie</h2>
              <form id="gallery-form" class="form-grid">
                <div class="field"><label>Mannschaft</label><select id="gallery-team" required></select></div>
                <div class="field"><label>Titel</label><input id="gallery-title" required /></div>
                <div class="field full"><label>Bilder</label><input id="gallery-files" type="file" accept="image/jpeg,image/png,image/webp,image/avif" multiple required /></div>
                <div class="field"><button class="button" type="submit">Galerie anlegen & hochladen</button></div>
              </form>
              <div id="galleries-list" class="grid two"></div>
            </div>
          </section>

          <section id="panel-facility" class="admin-panel">
            <div class="card">
              <h2>Anlagenstatus</h2>
              <form id="facility-form" class="form-grid">
                <div class="field"><label>Status</label><select id="facility-status"><option value="open">Geöffnet</option><option value="limited">Teilweise geöffnet</option><option value="closed">Gesperrt</option></select></div>
                <div class="field full"><label>Hinweis</label><textarea id="facility-message"></textarea></div>
                <div class="field"><button class="button" type="submit">Status speichern</button></div>
              </form>
              <div id="courts-admin-list" class="stack"></div>
            </div>
          </section>

          <section id="panel-content" class="admin-panel">
            <div class="card">
              <h2>Seiteninhalte</h2>
              <form id="page-form" class="form-grid">
                <div class="field"><label>Seite</label><select id="page-select"></select></div>
                <div class="field"><label>Titel</label><input id="page-title" /></div>
                <div class="field full"><label>Inhalt</label><textarea id="page-body"></textarea></div>
                <div class="field"><label>Meta-Titel</label><input id="page-meta-title" /></div>
                <div class="field"><label>Meta-Beschreibung</label><input id="page-meta-description" /></div>
                <div class="field"><button class="button" type="submit">Seite speichern</button></div>
              </form>
            </div>
            <div class="grid two">
              <div class="card"><h2>Sponsor anlegen</h2><form id="sponsor-form" class="form-grid"><div class="field full"><label>Name</label><input id="sponsor-name" required /></div><div class="field full"><label>Website</label><input id="sponsor-url" type="url" /></div><div class="field full"><label>Beschreibung</label><textarea id="sponsor-description"></textarea></div><div class="field"><button class="button" type="submit">Sponsor speichern</button></div></form></div>
              <div class="card"><h2>Funktionär anlegen</h2><form id="official-form" class="form-grid"><div class="field full"><label>Name</label><input id="official-name" required /></div><div class="field"><label>Funktion</label><input id="official-title" required /></div><div class="field"><label>E-Mail</label><input id="official-email" type="email" /></div><div class="field"><label>Telefon</label><input id="official-phone" /></div><div class="field"><button class="button" type="submit">Funktionär speichern</button></div></form></div>
            </div>
          </section>

          <section id="panel-users" class="admin-panel">
            <div class="card">
              <h2>Benutzer einladen</h2>
              <form id="invite-form" class="form-grid">
                <div class="field"><label>Name</label><input id="invite-name" required /></div>
                <div class="field"><label>E-Mail</label><input id="invite-email" type="email" required /></div>
                <div class="field"><label>Globale Rolle</label><select id="invite-global-role"><option value="user">Mannschafts-Nutzer</option><option value="super_admin">SuperAdmin</option></select></div>
                <div class="field"><label>Team-Rolle</label><select id="invite-team-role"><option value="editor">Editor</option><option value="manager">Manager</option><option value="ticker">Nur Liveticker</option></select></div>
                <div class="field full"><label>Mannschaften</label><div id="invite-teams" class="grid"></div></div>
                <div class="field"><button class="button" type="submit">Einladung senden</button></div>
              </form>
            </div>
            <div class="card"><h2>Benutzer</h2><div id="users-list" class="table-wrap"></div></div>
          </section>

          <section id="panel-account" class="admin-panel">
            <div class="card">
              <h2>Mein Konto</h2>
              <form id="password-form" class="form-grid">
                <div class="field"><label>Neues Passwort</label><input id="new-password" type="password" minlength="10" required /></div>
                <div class="field"><button class="button" type="submit">Passwort setzen</button></div>
              </form>
            </div>
          </section>
        </div>
      </div>
    </section>
  </div>
</MainLayout>
<script>
  import { initAdmin } from '../../scripts/admin';
  initAdmin();
</script>
