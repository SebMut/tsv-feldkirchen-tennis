---
import MainLayout from '../../layouts/MainLayout.astro';
---
<MainLayout title="Aktuelles | TSV Feldkirchen Tennis" description="News, Veranstaltungen und Spielberichte der Tennisabteilung TSV Feldkirchen.">
  <div class="container stack aktuelles-page">
    <div class="page-head aktuelles-page__head"><div><p class="eyebrow">Aktuelles</p><h1>Neuigkeiten & Veranstaltungen</h1><p class="muted">Alles Wichtige rund um die Tennisabteilung auf einen Blick.</p></div></div>
    <section id="event-news" class="event-news" aria-labelledby="event-news-title" hidden>
      <div class="event-news__head">
        <div><p class="eyebrow">Termine</p><h2 id="event-news-title">Demnächst bei uns</h2></div>
        <a href="/termine/" class="button ghost">Alle Termine →</a>
      </div>
      <div id="event-news-list" class="content-card-grid"></div>
    </section>
    <section class="news-section" aria-label="Weitere Neuigkeiten">
      <div id="news-list" class="content-card-grid"><p class="muted">Aktuelle Beiträge werden ermittelt …</p></div>
    </section>
  </div>
</MainLayout>
<script>
  import { loadNews } from '../../scripts/public';
  import { mediaUrl, supabase } from '../../lib/supabase';
  import { escapeHtml, formatDateTime } from '../../lib/ui';

  const section = document.querySelector<HTMLElement>('#event-news');
  const list = document.querySelector<HTMLElement>('#event-news-list');
  const newsList = document.querySelector<HTMLElement>('#news-list');
  const linkedNewsIds = new Set<string>();
  const eventTitles = new Set<string>();
  const plainText = (value: unknown) => String(value || '')
    .replace(/\*\*/g, '')
    .replace(/^\s*[🥨🎾🍂🍻📍]+\s*/u, '')
    .replace(/\s+/g, ' ')
    .trim();
  const cleanTitle = (value: unknown) => plainText(value)
    .replace(/^[–—-]+\s*/, '')
    .replace(/[!]+\s*$/, '')
    .replace(/[🍂🎾🍻🥨]+\s*$/u, '')
    .trim();

  if (section && list) {
    const { data: events } = await supabase
      .from('events')
      .select('*')
      .eq('status', 'published')
      .order('starts_at', { ascending: true });

    const now = Date.now();
    const rows = (events ?? []).filter((event: any) => {
      const end = event.ends_at ? new Date(event.ends_at).getTime() : new Date(event.starts_at).getTime() + 86400000;
      return end >= now - 86400000;
    });

    rows.forEach((event: any) => {
      eventTitles.add(String(event.title || '').trim());
      const match = typeof event.slug === 'string' ? /^news-([0-9a-f-]{36})$/i.exec(event.slug) : null;
      if (match) linkedNewsIds.add(match[1]);
    });

    if (rows.length) {
      section.hidden = false;
      list.innerHTML = rows.map((event: any) => {
        const href = event.rsvp_enabled && event.slug ? `/veranstaltung/?slug=${encodeURIComponent(event.slug)}` : '/termine/';
        const description = plainText(event.description) || 'Alle Informationen zur Veranstaltung findest du im Kalender.';
        const linkedNewsId = typeof event.slug === 'string' ? /^news-([0-9a-f-]{36})$/i.exec(event.slug)?.[1] : undefined;
        const eventImage = event.hero_image_path ? mediaUrl(event.hero_image_path) : '/images/veranstaltung-ai.svg';
        return `
          <article class="content-card content-card--event">
            <a class="content-card__media${event.hero_image_path ? ' content-card__media--poster' : ''}" href="${href}" aria-label="${escapeHtml(cleanTitle(event.title))} öffnen">
              <img data-event-news-id="${escapeHtml(linkedNewsId || '')}" data-event-has-image="${event.hero_image_path ? 'true' : 'false'}" src="${escapeHtml(eventImage)}" alt="${escapeHtml(cleanTitle(event.title))}" loading="lazy" />
            </a>
            <div class="content-card__body">
              <div class="content-card__meta"><span class="content-card__badge">Veranstaltung</span><time>${event.all_day ? 'Ganztägig · ' : ''}${escapeHtml(formatDateTime(event.starts_at))}</time></div>
              <h3><a href="${href}">${escapeHtml(cleanTitle(event.title))}</a></h3>
              <p class="content-card__description">${escapeHtml(description)}</p>
              <div class="content-card__footer"><span>📍 ${escapeHtml(event.location_name || 'TSV Feldkirchen')}</span><a href="${href}">${event.rsvp_enabled ? 'Details & Teilnahme' : 'Details'} →</a></div>
            </div>
          </article>`;
      }).join('');

      if (linkedNewsIds.size) {
        const { data: linkedNews } = await supabase.from('news').select('id,hero_image_path').in('id', [...linkedNewsIds]);
        (linkedNews ?? []).forEach((article: any) => {
          if (!article.hero_image_path) return;
          const image = list.querySelector<HTMLImageElement>(`img[data-event-news-id="${article.id}"]`);
          if (image && image.dataset.eventHasImage !== 'true') image.src = mediaUrl(article.hero_image_path);
        });
      }
    }
  }

  await loadNews();
  newsList?.querySelectorAll<HTMLElement>('article.card').forEach(card => {
    const rawTitle = card.querySelector('h2')?.textContent?.trim() || '';
    if (eventTitles.has(rawTitle)) { card.remove(); return; }

    card.classList.add('content-card', 'content-card--news');
    card.classList.remove('card');
    const image = card.querySelector<HTMLImageElement>(':scope > img');
    if (image) {
      const media = document.createElement('div');
      media.className = 'content-card__media';
      image.removeAttribute('style');
      image.parentNode?.insertBefore(media, image);
      media.appendChild(image);
    }
    const label = card.querySelector<HTMLElement>('.news-reschedule-label');
    const date = card.querySelector<HTMLElement>('.eyebrow');
    const title = card.querySelector<HTMLElement>('h2');
    const excerpt = card.querySelector<HTMLElement>('p.muted');
    const details = card.querySelector<HTMLDetailsElement>('details');
    const body = document.createElement('div');
    body.className = 'content-card__body';
    const meta = document.createElement('div');
    meta.className = 'content-card__meta';
    const badge = document.createElement('span');
    badge.className = 'content-card__badge';
    badge.textContent = label?.textContent?.trim() || 'Neuigkeit';
    meta.appendChild(badge);
    if (date) { date.className = ''; meta.appendChild(date); }
    body.appendChild(meta);
    if (title) { title.textContent = cleanTitle(title.textContent); body.appendChild(title); }
    if (excerpt) { excerpt.className = 'content-card__description'; excerpt.textContent = plainText(excerpt.textContent); body.appendChild(excerpt); }
    if (details) {
      details.className = 'content-card__details';
      const summary = details.querySelector('summary');
      if (summary) summary.textContent = 'Weiterlesen →';
      body.appendChild(details);
    }
    label?.remove();
    card.appendChild(body);
  });
</script>
<style>
  .aktuelles-page{padding-bottom:calc(130px + env(safe-area-inset-bottom));gap:34px}
  .aktuelles-page__head{padding-bottom:4px}
  .aktuelles-page__head h1{max-width:760px;color:#193c2c}
  .event-news,.news-section{margin:0}
  .event-news__head{display:flex;align-items:end;justify-content:space-between;gap:16px;margin-bottom:18px}
  .event-news__head h2{margin:2px 0 0;color:#193c2c}
  .content-card-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px;align-items:start}
  :global(.content-card){overflow:hidden;border:1px solid #dfe7e1;border-radius:20px;background:#fff;box-shadow:0 10px 30px rgb(25 60 44 / .08)}
  /* Exact aspect ratio of the supplied event banner: no letterboxing above or below.
     All content cards share this frame; other photos fill it by cropping their edges. */
  :global(.content-card__media){display:block;position:relative;aspect-ratio:1773/885;overflow:hidden;background:#fff;padding:0!important;line-height:0}
  :global(.content-card__media img){display:block;position:absolute;inset:0;width:100%;height:100%;margin:0!important;padding:0!important;border:0!important;border-radius:0!important;object-fit:cover}
  :global(.content-card--event .content-card__media--poster){aspect-ratio:1773/885;overflow:hidden;padding:0!important}
  :global(.content-card--event .content-card__media--poster img){width:100%;height:100%;object-fit:cover}
  :global(.content-card__body){padding:18px 20px 20px}
  :global(.content-card__meta){display:flex;align-items:center;flex-wrap:wrap;gap:8px 10px;margin:0 0 11px;color:#68756e;font-size:.74rem;font-weight:750;letter-spacing:.025em}
  :global(.content-card__badge){display:inline-flex;align-items:center;min-height:24px;padding:4px 9px;border-radius:999px;background:#e30613;color:#fff;font-size:.66rem;font-weight:900;letter-spacing:.07em;text-transform:uppercase}
  :global(.content-card h2),:global(.content-card h3){margin:0 0 10px;color:#193c2c;font-size:clamp(1.18rem,2vw,1.48rem);line-height:1.18;letter-spacing:-.018em}
  :global(.content-card h2 a),:global(.content-card h3 a){color:inherit;text-decoration:none}
  :global(.content-card__description){display:-webkit-box;margin:0;overflow:hidden;color:#617068;font-size:.96rem;line-height:1.52;-webkit-box-orient:vertical;-webkit-line-clamp:3}
  :global(.content-card__footer){display:flex;align-items:center;justify-content:space-between;gap:14px;margin-top:16px;padding-top:13px;border-top:1px solid #edf1ee;color:#40564a;font-size:.83rem;font-weight:650}
  :global(.content-card__footer a){flex:none;color:#d5091a;font-weight:850;text-decoration:none}
  :global(.content-card__details){margin-top:14px;padding-top:12px;border-top:1px solid #edf1ee}
  :global(.content-card__details summary){cursor:pointer;list-style:none;color:#d5091a;font-size:.86rem;font-weight:850}
  :global(.content-card__details summary::-webkit-details-marker){display:none}
  :global(.content-card__details p){margin:12px 0 0;color:#53635b;font-size:.9rem;line-height:1.55}
  :global(.content-card--news:not(:has(.content-card__media)) .content-card__body){padding-top:20px}
  @media(max-width:760px){
    .aktuelles-page{gap:28px;padding-bottom:calc(150px + env(safe-area-inset-bottom))}
    .aktuelles-page__head{padding-top:4px}.aktuelles-page__head h1{font-size:clamp(2rem,9vw,2.65rem);line-height:1.02}
    .event-news__head{align-items:flex-end;margin-bottom:13px}.event-news__head .button{font-size:.76rem;padding:8px 10px}
    .event-news__head h2{font-size:1.45rem}
    .content-card-grid{grid-template-columns:1fr;gap:16px}
    :global(.content-card){border-radius:17px;box-shadow:0 7px 22px rgb(25 60 44 / .075)}
    :global(.content-card__media){aspect-ratio:1773/885}
    :global(.content-card__body){padding:15px 16px 16px}
    :global(.content-card__meta){margin-bottom:9px;font-size:.7rem}
    :global(.content-card h2),:global(.content-card h3){margin-bottom:8px;font-size:1.22rem;line-height:1.2}
    :global(.content-card__description){font-size:.92rem;line-height:1.48;-webkit-line-clamp:2}
    :global(.content-card__footer){margin-top:13px;padding-top:11px;font-size:.79rem}
  }
</style>
