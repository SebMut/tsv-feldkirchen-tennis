---
import MainLayout from '../../layouts/MainLayout.astro';
---
<MainLayout title="Aktuelles | TSV Feldkirchen Tennis" description="News, Veranstaltungen und Spielberichte der Tennisabteilung TSV Feldkirchen.">
  <div class="container stack aktuelles-page">
    <div class="page-head"><div><p class="eyebrow">Vereinsleben</p><h1>Aktuelles</h1><p class="muted">Neuigkeiten, Veranstaltungen und wichtige Infos rund um die Tennisabteilung.</p></div></div>
    <section id="event-news" class="event-news" aria-labelledby="event-news-title" hidden>
      <div class="event-news__head">
        <div><p class="eyebrow">Veranstaltungen</p><h2 id="event-news-title">Das ist bei uns los</h2></div>
        <a href="/termine/" class="button ghost">Alle Termine →</a>
      </div>
      <div id="event-news-list" class="event-news__grid"></div>
    </section>
    <section aria-labelledby="news-title">
      <div class="event-news__head"><div><p class="eyebrow">Neuigkeiten</p><h2 id="news-title">Aus der Tennisabteilung</h2></div></div>
      <div id="news-list" class="grid two"><p class="muted">Aktuelle Beiträge werden ermittelt …</p></div>
    </section>
  </div>
</MainLayout>
<script>
  import { loadNews } from '../../scripts/public';
  import { mediaUrl, supabase } from '../../lib/supabase';
  import { escapeHtml, formatDateTime } from '../../lib/ui';

  const section = document.querySelector<HTMLElement>('#event-news');
  const list = document.querySelector<HTMLElement>('#event-news-list');
  const newsList = document.querySelector<HTMLElement>('#news-list');
  const linkedNewsIds = new Set<string>();
  const eventTitles = new Set<string>();
  const plainText = (value: unknown) => String(value || '')
    .replace(/\*\*/g, '')
    .replace(/^\s*[🥨🎾🍂🍻📍]+\s*/u, '')
    .replace(/\s+/g, ' ')
    .trim();
  const cleanTitle = (value: unknown) => plainText(value)
    .replace(/^[–—-]+\s*/, '')
    .replace(/[!]+\s*$/, '')
    .trim();

  if (section && list) {
    const { data: events } = await supabase
      .from('events')
      .select('*')
      .eq('status', 'published')
      .order('starts_at', { ascending: true });

    const now = Date.now();
    const rows = (events ?? []).filter((event: any) => {
      const end = event.ends_at ? new Date(event.ends_at).getTime() : new Date(event.starts_at).getTime() + 86400000;
      return end >= now - 86400000;
    });

    rows.forEach((event: any) => {
      eventTitles.add(String(event.title || '').trim());
      const match = typeof event.slug === 'string' ? /^news-([0-9a-f-]{36})$/i.exec(event.slug) : null;
      if (match) linkedNewsIds.add(match[1]);
    });

    if (rows.length) {
      section.hidden = false;
      list.innerHTML = rows.map((event: any) => {
        const href = event.rsvp_enabled && event.slug
          ? `/veranstaltung/?slug=${encodeURIComponent(event.slug)}`
          : '/termine/';
        const description = plainText(event.description) || 'Alle Informationen zur Veranstaltung findest du im Kalender.';
        const linkedNewsId = typeof event.slug === 'string' ? /^news-([0-9a-f-]{36})$/i.exec(event.slug)?.[1] : undefined;
        return `
          <article class="event-news-card">
            <a class="event-news-card__image" href="${href}" aria-label="${escapeHtml(cleanTitle(event.title))} öffnen">
              <img data-event-news-id="${escapeHtml(linkedNewsId || '')}" src="/images/veranstaltung-ai.svg" alt="Stimmungsbild zur Veranstaltung ${escapeHtml(cleanTitle(event.title))}" loading="lazy" />
              <span>Veranstaltung</span>
            </a>
            <div class="event-news-card__body">
              <p class="event-news-card__date">${event.all_day ? 'Ganztägig · ' : ''}${escapeHtml(formatDateTime(event.starts_at))}</p>
              <h3><a href="${href}">${escapeHtml(cleanTitle(event.title))}</a></h3>
              <p class="event-news-card__description">${escapeHtml(description)}</p>
              <div class="event-news-card__footer">
                <span class="event-news-card__place">📍 ${escapeHtml(event.location_name || 'TSV Feldkirchen')}</span>
                <a class="event-news-card__link" href="${href}">${event.rsvp_enabled ? 'Teilnahme & Details' : 'Termin ansehen'} →</a>
              </div>
            </div>
          </article>`;
      }).join('');

      if (linkedNewsIds.size) {
        const { data: linkedNews } = await supabase
          .from('news')
          .select('id,hero_image_path')
          .in('id', [...linkedNewsIds]);
        (linkedNews ?? []).forEach((article: any) => {
          if (!article.hero_image_path) return;
          const image = list.querySelector<HTMLImageElement>(`img[data-event-news-id="${article.id}"]`);
          if (image) image.src = mediaUrl(article.hero_image_path);
        });
      }
    }
  }

  await loadNews();
  newsList?.querySelectorAll<HTMLElement>('article.card').forEach(card => {
    const title = card.querySelector('h2')?.textContent?.trim() || '';
    if (eventTitles.has(title)) card.remove();
  });
</script>
<style>
  .aktuelles-page{padding-bottom:42px}
  .event-news{margin-bottom:12px}
  .event-news__head{display:flex;align-items:end;justify-content:space-between;gap:16px;margin-bottom:18px}
  .event-news__head h2{margin:2px 0 0;color:#193c2c}
  .event-news__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}
  .event-news-card{overflow:hidden;border:1px solid #dfe7e1;border-radius:20px;background:#fff;box-shadow:0 10px 28px rgb(25 60 44 / .08)}
  .event-news-card__image{position:relative;display:block;aspect-ratio:16/8;overflow:hidden;background:#193c2c}
  .event-news-card__image img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .25s ease}
  .event-news-card:hover .event-news-card__image img{transform:scale(1.025)}
  .event-news-card__image span{position:absolute;left:14px;top:14px;padding:6px 10px;border-radius:999px;background:#e30613;color:#fff;font-size:.7rem;font-weight:850;letter-spacing:.06em;text-transform:uppercase;text-decoration:none}
  .event-news-card__body{padding:18px 20px 20px}
  .event-news-card__date{margin:0 0 8px;color:#b51224;font-size:.78rem;font-weight:850;text-transform:uppercase;letter-spacing:.055em}
  .event-news-card h3{margin:0 0 10px;font-size:clamp(1.18rem,2vw,1.5rem);line-height:1.2;letter-spacing:-.015em}
  .event-news-card h3 a{color:#193c2c;text-decoration:none}
  .event-news-card__description{margin:0;color:#65736b;font-size:.98rem;line-height:1.55;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
  .event-news-card__footer{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-top:16px;padding-top:14px;border-top:1px solid #edf1ee}
  .event-news-card__place{color:#40564a;font-size:.85rem;font-weight:650}
  .event-news-card__link{flex:none;color:#e30613;font-size:.88rem;font-weight:850;text-decoration:none}
  @media(max-width:760px){
    .event-news__head{align-items:flex-start}.event-news__head .button{font-size:.78rem;padding:8px 10px}
    .event-news__grid{grid-template-columns:1fr;gap:14px}
    .event-news-card{border-radius:16px}.event-news-card__image{aspect-ratio:16/8.5}.event-news-card__body{padding:15px 16px 16px}
    .event-news-card h3{font-size:1.24rem;line-height:1.18;margin-bottom:8px}
    .event-news-card__description{font-size:.93rem;line-height:1.48;-webkit-line-clamp:2}
    .event-news-card__footer{margin-top:13px;padding-top:12px;align-items:flex-end}.event-news-card__place{font-size:.8rem}.event-news-card__link{font-size:.82rem}
  }
</style>
