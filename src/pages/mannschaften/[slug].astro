---
import MainLayout from '../../layouts/MainLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

export function getStaticPaths() {
  const slugs = [
    'herren','herren-ii','herren-iii','herren-40','herren-40-ii','herren-50','herren-50-ii',
    'damen','damen-30','damen-40','damen-50',
    'junioren-18','junioren-18-ii','knaben-15','knaben-15-ii','maedchen-15',
    'bambini-12','bambini-12-ii','bambini-12-iii','kleinfeld-u9'
  ];
  return slugs.map((slug) => ({ params: { slug } }));
}
const { slug } = Astro.params;
const teamNames: Record<string, string> = {
  'herren': 'Herren', 'herren-ii': 'Herren II', 'herren-iii': 'Herren III',
  'herren-40': 'Herren 40', 'herren-40-ii': 'Herren 40 II', 'herren-50': 'Herren 50', 'herren-50-ii': 'Herren 50 II',
  'damen': 'Damen', 'damen-30': 'Damen 30', 'damen-40': 'Damen 40', 'damen-50': 'Damen 50',
  'junioren-18': 'Junioren 18', 'junioren-18-ii': 'Junioren 18 II', 'knaben-15': 'Knaben 15', 'knaben-15-ii': 'Knaben 15 II',
  'maedchen-15': 'Mädchen 15', 'bambini-12': 'Bambini 12', 'bambini-12-ii': 'Bambini 12 II',
  'bambini-12-iii': 'Bambini 12 III', 'kleinfeld-u9': 'Kleinfeld U9'
};
const teamName = teamNames[slug ?? ''] ?? 'Mannschaft';
const teamGroup = slug?.startsWith('herren') ? { label: 'Herren', key: 'herren' }
  : slug?.startsWith('damen') ? { label: 'Damen', key: 'damen' }
  : slug?.startsWith('junioren') ? { label: 'Junioren', key: 'junioren' }
  : slug?.startsWith('knaben') ? { label: 'Knaben', key: 'knaben' }
  : slug?.startsWith('maedchen') ? { label: 'Mädchen', key: 'maedchen' }
  : slug?.startsWith('bambini') ? { label: 'Bambini', key: 'bambini' }
  : { label: 'Kleinfeld', key: 'kleinfeld' };
const breadcrumbItems = [
  { label: 'Startseite', href: '/' },
  { label: 'Mannschaften', href: '/mannschaften/' },
  ...(teamName === teamGroup.label ? [] : [{ label: teamGroup.label, href: `/mannschaften/?category=${teamGroup.key}` }]),
  { label: teamName }
];
---
<MainLayout title="Mannschaft | TSV Feldkirchen Tennis">
  <div class="container stack team-detail-page" data-team-slug={slug}>
    <Breadcrumbs items={breadcrumbItems} />
    <div id="team-header"><p class="muted">Mannschaft wird geladen …</p></div>
    <section id="team-next-match" class="hidden" aria-live="polite"></section>
    <section class="grid two">
      <article class="card"><p class="eyebrow">Kader</p><div id="team-roster"></div></article>
      <article class="card"><p class="eyebrow">Saison</p><div id="team-season"></div><div class="field"><p class="eyebrow">Saison auswählen</p><nav id="team-season-nav" class="teams-category-chips" aria-label="Mannschaftssaison auswählen"></nav></div></article>
    </section>
    <section class="phase8-stats" aria-labelledby="team-stats-heading"><p class="eyebrow">Saison im Überblick</p><h2 id="team-stats-heading">Unsere Saisonbilanz</h2><div id="team-stats"><p class="muted">Statistik wird ermittelt …</p></div></section>
    <section class="card" aria-labelledby="team-standings-heading"><p class="eyebrow">BTV-Gruppentabelle</p><h2 id="team-standings-heading">Tabelle</h2><div id="team-standings"><p class="muted">Tabelle wird geladen …</p></div></section>
    <section class="card"><p class="eyebrow">Spiele</p><div id="team-matches" class="match-list"></div></section>
    <section class="card"><p class="eyebrow">Neuigkeiten</p><div id="team-news" class="news-list"></div></section>
    <section class="card"><p class="eyebrow">Bilder</p><div id="team-gallery" class="grid"></div></section>
    <section id="team-sponsors" class="hidden" aria-label="Mannschaftssponsoren"></section>
  </div>
</MainLayout>
<script>
  import { loadTeamDetail } from '../../scripts/public';
  const root = document.querySelector<HTMLElement>('[data-team-slug]');
  if (root?.dataset.teamSlug) loadTeamDetail(root.dataset.teamSlug);
</script>
