---
import MainLayout from '../../layouts/MainLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
---
<MainLayout title="Mannschaften | TSV Feldkirchen Tennis" description="Alle TSV Feldkirchen Tennismannschaften aus Sommer- und Winterrunde – mit Spielplan, Liga, Kader und Ergebnissen.">
  <div class="container stack teams-page">
    <Breadcrumbs items={[{ label: 'Startseite', href: '/' }, { label: 'Mannschaften' }]} />
    <header class="teams-page__intro">
      <p class="eyebrow">Unser Sport · TSV Feldkirchen</p>
      <h1>Unsere <span>Mannschaften</span></h1>
      <p>Sommer oder Winter? Entdecke die Teams und Spieltage der jeweiligen Runde.</p>
    </header>

    <nav class="teams-seasons" aria-label="Saison auswählen" id="teams-season-nav">
      <div class="teams-season-skeleton" role="status" aria-label="Saisons werden geladen" aria-live="polite"></div>
      <div class="teams-season-skeleton" aria-hidden="true"></div>
      <div class="teams-season-skeleton" aria-hidden="true"></div>
    </nav>

    <section class="teams-results" aria-labelledby="teams-results-title">
      <div class="teams-results__heading">
        <div><p class="eyebrow">Im Überblick</p><h2 id="teams-results-title">Mannschaften</h2><p id="teams-results-info" class="muted" aria-live="polite">Mannschaften werden geladen …</p></div>
        <a class="teams-results__official" href="https://www.btv.de/de/mein-verein/vereinsseite/tsv-feldkirchen.html" target="_blank" rel="noopener noreferrer">Offizielle BTV-Vereinsseite ↗</a>
      </div>
      <div class="teams-category-chips" id="teams-category-chips" role="group" aria-label="Mannschaftskategorie"></div>
      <div id="teams-grid" class="team-grid" aria-live="polite">
        <div class="team-card-skeleton" role="status" aria-label="Mannschaften werden geladen"><div></div><span></span><span></span></div>
        <div class="team-card-skeleton" aria-hidden="true"><div></div><span></span><span></span></div>
        <div class="team-card-skeleton" aria-hidden="true"><div></div><span></span><span></span></div>
      </div>
    </section>

    <section class="teams-official-widget" aria-labelledby="teams-official-widget-title">
      <div class="teams-results__heading">
        <div>
          <p class="eyebrow">Direkt vom Deutschen Tennis Bund</p>
          <h2 id="teams-official-widget-title">Offizielle Mannschaftsübersicht</h2>
          <p class="muted">Die Mannschaftssuche von tennis.de zeigt automatisch die aktuell gemeldete Saison mit Tabellen, Spielplänen und Meldungen. Für frühere Sommer- und Winterrunden, unsere tatsächlichen Hallenspielorte und den TSV-Liveticker nutze die Mannschaftenübersicht oben.</p>
        </div>
      </div>
      <p class="muted">
        <a href="https://www.tennis.de/spielen/spielbetrieb/mannschaftssuche.html?verband=btv&amp;verein=01012#teamportrait/3728614" target="_blank" rel="noopener noreferrer">Beispiel: direktes Mannschaftsportrait bei tennis.de ↗</a>
      </p>
      <details class="card teams-official-widget__details" id="official-tennisde-widget">
        <summary>Offizielle tennis.de-Mannschaftssuche öffnen</summary>
        <p class="muted">Beim Öffnen werden Inhalte vom externen Anbieter tennis.de geladen. Unsere Mannschaftsdaten und Ergebnisse bleiben weiterhin in der TSV-Datenbank.</p>
        <iframe
          title="Offizielle tennis.de-Mannschaftssuche für TSV Feldkirchen, BTV-Vereinsnummer 01012"
          data-src="https://services.tennis.de/extern/tennisdeteamsearch.zul?verband=BTV&amp;verein=01012&amp;linkfarbe=20aebd"
          loading="lazy"
          width="100%"
          height="800"
          referrerpolicy="strict-origin-when-cross-origin"
          class="teams-official-widget__frame"
        ></iframe>
        <p class="muted">Falls die Übersicht nicht lädt: <a href="https://services.tennis.de/extern/tennisdeteamsearch.zul?verband=BTV&amp;verein=01012&amp;linkfarbe=20aebd" target="_blank" rel="noopener noreferrer">Offizielle Mannschaftssuche direkt öffnen ↗</a></p>
      </details>
    </section>
  </div>
</MainLayout>
<script>
  import { loadTeams } from '../../scripts/public';
  loadTeams();

  // Load the third-party iframe only after a deliberate click; do not
  // contact tennis.de automatically just because the TSV page was visited.
  const officialWidget = document.querySelector<HTMLDetailsElement>('#official-tennisde-widget');
  officialWidget?.addEventListener('toggle', () => {
    if (!officialWidget.open) return;
    const frame = officialWidget.querySelector<HTMLIFrameElement>('iframe[data-src]');
    if (frame?.dataset.src && !frame.src) {
      frame.src = frame.dataset.src;
    }
  });
</script>
