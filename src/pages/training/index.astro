---
import MainLayout from '../../layouts/MainLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const schoolUrl = 'https://www.tennisschule-alexbraun.de/';
const offersUrl = 'https://www.tennisschule-alexbraun.de/angebote/';
const coachesUrl = 'https://www.tennisschule-alexbraun.de/trainerteam/';
const logoUrl = 'https://i0.wp.com/www.tennisschule-alexbraun.de/wp-content/uploads/2025/09/logo-weiss_1pt_original-1.png?fit=789%2C802&ssl=1';
const coachPhoto = 'https://i0.wp.com/www.tennisschule-alexbraun.de/wp-content/uploads/2025/07/startseite_1.jpg?fit=675%2C981&ssl=1';
const trainingPhoto = 'https://i0.wp.com/www.tennisschule-alexbraun.de/wp-content/uploads/2025/07/startseite_3.jpg?fit=500%2C331&ssl=1';
---
<MainLayout
  title="Training | TSV Feldkirchen Tennis"
  description="Tennistraining beim TSV Feldkirchen mit der Tennisschule Alex Braun: Sommertraining, Wintertraining, Einzel- und Gruppentraining sowie Tenniscamps."
>
  <div class="container training-simple" data-managed-page="training">
    <Breadcrumbs items={[{ label: 'Startseite', href: '/' }, { label: 'Training' }]} />

    <section class="training-simple__panel" aria-labelledby="training-heading">
      <div class="training-simple__main">
        <p class="training-simple__eyebrow">TSV Feldkirchen Tennis</p>
        <h1 id="training-heading">Tennistraining</h1>
        <p class="training-simple__intro">Unser Training für Kinder, Jugendliche und Erwachsene wird von der <strong>Tennisschule Alex Braun</strong> organisiert – vom Einstieg bis zum Mannschaftssport.</p>

        <h2>Welche Trainingsangebote gibt es?</h2>
        <ul class="training-simple__list">
          <li><strong>Sommertraining</strong> – auf dem Sandplatz, von Mai bis September</li>
          <li><strong>Wintertraining</strong> – in der Tennishalle, von Oktober bis April</li>
          <li><strong>Einzeltraining</strong> – individuelle Förderung und Techniktraining</li>
          <li><strong>Gruppentraining</strong> – gemeinsames Training für jedes Spielniveau</li>
          <li><strong>Mannschaftstraining</strong> – gezielte Vorbereitung auf Punktspiele</li>
          <li><strong>Tenniscamps</strong> – in den Oster-, Pfingst- und Sommerferien</li>
        </ul>

        <div class="training-simple__links">
          <a class="training-simple__button" href={offersUrl} target="_blank" rel="noopener noreferrer">Trainingsangebote &amp; Anmeldung <span aria-hidden="true">↗</span></a>
          <a class="training-simple__text-link" href={coachesUrl} target="_blank" rel="noopener noreferrer">Trainerteam ansehen ↗</a>
        </div>
        <p class="training-simple__hint">Trainingszeiten, verfügbare Plätze und Preise findest du direkt bei der Tennisschule.</p>
      </div>

      <aside class="training-simple__partner" aria-label="Unser Trainingspartner Tennisschule Alex Braun">
        <a class="training-simple__brand" href={schoolUrl} target="_blank" rel="noopener noreferrer">
          <img src={logoUrl} alt="Logo Tennisschule Alex Braun" width="130" height="130" loading="eager" decoding="async" />
          <span>Tennisschule<br /><strong>Alex Braun</strong></span>
        </a>
        <div class="training-simple__photos">
          <img src={coachPhoto} alt="Alex Braun beim Tennistraining – Foto: Tennisschule Alex Braun" width="675" height="981" loading="lazy" decoding="async" />
          <img src={trainingPhoto} alt="Tennistraining – Foto: Tennisschule Alex Braun" width="500" height="331" loading="lazy" decoding="async" />
        </div>
        <p>Fotos und Logo: <a href={schoolUrl} target="_blank" rel="noopener noreferrer">Tennisschule Alex Braun</a></p>
      </aside>
    </section>

    <details class="training-simple__more">
      <summary>Weitere organisatorische Informationen</summary>
      <div id="managed-page-content" aria-live="polite">Informationen werden geladen …</div>
    </details>
  </div>
</MainLayout>

<script>
  import { loadManagedPage } from '../../scripts/public';
  loadManagedPage('training');
</script>

<style>
  .training-simple{display:grid;gap:18px;color:#1d2c23}
  .training-simple :global(.breadcrumbs){padding-top:0}
  .training-simple__panel{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(270px,.78fr);gap:clamp(20px,3vw,42px);padding:clamp(22px,3vw,44px);background:#fff;border:1px solid #e0e5df;border-radius:16px}
  .training-simple__eyebrow{margin:0 0 8px;font-size:.75rem;letter-spacing:.1em;text-transform:uppercase;color:#c20b19;font-weight:850}
  .training-simple h1{font-size:clamp(2rem,3.4vw,3.7rem);color:#172820;letter-spacing:-.04em;margin:0 0 14px}
  .training-simple__intro{max-width:740px;margin:0 0 27px;color:#526158;line-height:1.62;font-size:1.04rem}
  .training-simple__main h2{font-size:clamp(1.25rem,1.8vw,1.6rem);margin:0 0 14px;letter-spacing:-.02em;color:#1b2e23}
  .training-simple__list{display:grid;gap:11px;padding-left:22px;margin:0 0 27px;color:#43544a;line-height:1.48;font-size:.96rem}
  .training-simple__list li{padding-left:3px}
  .training-simple__list li::marker{color:#e30613}
  .training-simple__list strong{color:#1d2c23}
  .training-simple__links{display:flex;gap:13px 20px;align-items:center;flex-wrap:wrap}
  .training-simple__button{display:inline-flex;align-items:center;gap:20px;justify-content:space-between;text-decoration:none;background:#e30613;color:#fff;font-weight:800;border-radius:8px;padding:13px 17px;min-height:47px}
  .training-simple__button:hover{background:#b90e19}
  .training-simple__text-link{color:#b80817;font-weight:800;text-decoration:none;font-size:.9rem}
  .training-simple__text-link:hover{text-decoration:underline}
  .training-simple__hint{font-size:.81rem;margin:15px 0 0;color:#66756b}
  .training-simple__partner{min-width:0}
  .training-simple__brand{display:flex;align-items:center;gap:14px;min-height:118px;padding:12px 16px;background:#18322a;color:#fff;border-radius:10px 10px 0 0;text-decoration:none}
  .training-simple__brand img{width:92px;height:92px;object-fit:contain;flex:0 0 auto}
  .training-simple__brand>span{font-size:.9rem;line-height:1.3}
  .training-simple__brand strong{font-size:1.28rem}
  .training-simple__photos{display:grid;grid-template-columns:1fr 1fr;gap:7px;background:#eff2ed;padding:7px;border-radius:0 0 10px 10px}
  .training-simple__photos img{width:100%;height:252px;object-fit:cover;background:#dde7dc;border-radius:5px}
  .training-simple__photos img:first-child{object-position:center 27%}
  .training-simple__partner>p{color:#78857b;font-size:.72rem;margin:8px 0 0}
  .training-simple__partner>p a{color:#697b70}
  .training-simple__more{background:#fff;border:1px solid #e0e5df;border-radius:10px;padding:13px 19px}
  .training-simple__more summary{cursor:pointer;font-size:.87rem;font-weight:800;color:#3c5144}
  .training-simple__more>div{white-space:pre-line;padding-top:14px;color:#58695c;font-size:.87rem;overflow-wrap:anywhere}
  .training-simple a:focus-visible,.training-simple summary:focus-visible{outline:3px solid #e30613;outline-offset:3px}
  @media(max-width:900px){.training-simple__panel{grid-template-columns:1fr}.training-simple__partner{max-width:630px}.training-simple__photos img{height:190px}}
  @media(max-width:600px){.training-simple__panel{padding:21px 17px}.training-simple__intro{font-size:.95rem}.training-simple__list{font-size:.91rem}.training-simple__links{align-items:stretch;flex-direction:column}.training-simple__button{width:100%}.training-simple__brand{min-height:100px}.training-simple__brand img{width:76px;height:76px}.training-simple__photos img{height:150px}}
</style>
