---
import MainLayout from '../../layouts/MainLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const schoolUrl = 'https://www.tennisschule-alexbraun.de/';
const offersUrl = 'https://www.tennisschule-alexbraun.de/angebote/';
const coachesUrl = 'https://www.tennisschule-alexbraun.de/trainerteam/';
// Bilder von den Originalseiten der Tennisschule (Angebote / Startseite).
// Alle vier Motive sind absichtlich unterschiedlich.
const schoolImages = 'https://www.tennisschule-alexbraun.de/wp-content/uploads';
const logoUrl = `${schoolImages}/2025/09/logo-weiss_1pt_original-1.png`;
const coachPhoto = 'https://i0.wp.com/www.tennisschule-alexbraun.de/wp-content/uploads/2025/07/angebote_1.jpg?fit=500%2C333&ssl=1';
const trainingPhoto = 'https://i0.wp.com/www.tennisschule-alexbraun.de/wp-content/uploads/2025/07/angebote_4.jpg?fit=500%2C333&ssl=1';
const winterPhoto = 'https://i0.wp.com/www.tennisschule-alexbraun.de/wp-content/uploads/2025/07/startseite_4.jpg?fit=500%2C333&ssl=1';
const campPhoto = 'https://i0.wp.com/www.tennisschule-alexbraun.de/wp-content/uploads/2025/07/angebote_2.jpg?fit=500%2C333&ssl=1';
---
<MainLayout
  title="Training | TSV Feldkirchen Tennis"
  description="Tennistraining beim TSV Feldkirchen mit der Tennisschule Alex Braun: Sommertraining, Wintertraining, Einzel- und Gruppentraining sowie Tenniscamps."
>
  <div class="container training-simple">
    <Breadcrumbs items={[{ label: 'Startseite', href: '/' }, { label: 'Training' }]} />

    <section class="training-simple__panel" aria-labelledby="training-heading">
      <div class="training-simple__main">
        <p class="training-simple__eyebrow">TSV Feldkirchen Tennis</p>
        <h1 id="training-heading">Tennistraining</h1>
        <p class="training-simple__intro">Unser Training für Kinder, Jugendliche und Erwachsene wird von der <strong>Tennisschule Alex Braun</strong> organisiert – vom Einstieg bis zum Mannschaftssport.</p>

        <h2>Welche Trainingsangebote gibt es?</h2>
        <ul class="training-simple__list">
          <li><strong>Sommertraining</strong> – auf dem Sandplatz, von Mai bis September</li>
          <li><strong>Wintertraining</strong> – in der Tennishalle, von Oktober bis April</li>
          <li><strong>Einzeltraining</strong> – individuelle Förderung und Techniktraining</li>
          <li><strong>Gruppentraining</strong> – gemeinsames Training für jedes Spielniveau</li>
          <li><strong>Mannschaftstraining</strong> – gezielte Vorbereitung auf Punktspiele</li>
          <li><strong>Tenniscamps</strong> – in den Oster-, Pfingst- und Sommerferien</li>
        </ul>

        <div class="training-simple__links">
          <a class="training-simple__button" href={offersUrl} target="_blank" rel="noopener noreferrer">Trainingsangebote &amp; Anmeldung <span aria-hidden="true">↗</span></a>
          <a class="training-simple__text-link" href={coachesUrl} target="_blank" rel="noopener noreferrer">Trainerteam ansehen ↗</a>
        </div>
        <p class="training-simple__hint">Trainingszeiten, verfügbare Plätze und Preise findest du direkt bei der Tennisschule.</p>
      </div>

      <aside class="training-simple__partner" aria-label="Unser Trainingspartner Tennisschule Alex Braun">
        <a class="training-simple__brand" href={schoolUrl} target="_blank" rel="noopener noreferrer">
          <img src={logoUrl} data-school-image="logo" alt="Logo Tennisschule Alex Braun" referrerpolicy="no-referrer" width="130" height="130" loading="eager" decoding="async" />
          <span>Tennisschule<br /><strong>Alex Braun</strong></span>
        </a>
        <div class="training-simple__photos" aria-label="Bilder aus der Tennisschule Alex Braun">
          <img class="training-simple__coach-photo" src={coachPhoto} data-school-image="coach" alt="Einblick in die Tennisschule Alex Braun" referrerpolicy="no-referrer" width="675" height="981" loading="lazy" decoding="async" />
          <div class="training-simple__photo-strip">
            <img src={trainingPhoto} data-school-image="summer" alt="Sommertraining bei der Tennisschule Alex Braun" referrerpolicy="no-referrer" width="500" height="331" loading="lazy" decoding="async" />
            <img src={winterPhoto} data-school-image="winter" alt="Wintertraining bei der Tennisschule Alex Braun" referrerpolicy="no-referrer" width="500" height="333" loading="lazy" decoding="async" />
            <img src={campPhoto} data-school-image="camp" alt="Tenniscamps bei der Tennisschule Alex Braun" referrerpolicy="no-referrer" width="750" height="500" loading="lazy" decoding="async" />
          </div>
        </div>
        <p>Fotos und Logo: <a href={schoolUrl} target="_blank" rel="noopener noreferrer">Tennisschule Alex Braun</a></p>
      </aside>
    </section>

  </div>
</MainLayout>

<script>
  // Jeder Bildplatz hat nur eigene, andere Motive als mögliche Ersatzbilder.
  // Keine einheitliche Winterfoto-Ersatzadresse mehr: das hat alle
  // Vorschaubilder identisch gemacht. Bilder bleiben extern verlinkt.
  const base = 'https://www.tennisschule-alexbraun.de/wp-content/uploads/2025/07';
  const photon = 'https://i0.wp.com/www.tennisschule-alexbraun.de/wp-content/uploads/2025/07';
  const photos: Record<string, string[]> = {
    coach: [
      `${base}/angebote_1.jpg`,
      `${photon}/angebote_5.jpg?fit=500%2C333&ssl=1`,
      `${base}/angebote_5.jpg`,
    ],
    summer: [
      `${base}/angebote_4.jpg`,
      `${photon}/angebote_3.jpg?fit=500%2C331&ssl=1`,
      `${base}/angebote_3.jpg`,
    ],
    winter: [
      `${base}/startseite_4.jpg`,
      `${photon}/angebote_6.jpg?fit=500%2C333&ssl=1`,
      `${base}/angebote_6.jpg`,
    ],
    camp: [
      `${base}/angebote_2.jpg`,
      `${photon}/startseite_2.jpg?fit=750%2C500&ssl=1`,
      `${base}/startseite_2.jpg`,
    ],
  };
  for (const img of document.querySelectorAll<HTMLImageElement>('img[data-school-image]')) {
    const kind = img.dataset.schoolImage || '';
    const alternatives = kind === 'logo'
      ? ['https://i0.wp.com/www.tennisschule-alexbraun.de/wp-content/uploads/2025/09/logo-weiss_1pt_original-1.png?fit=789%2C802&ssl=1']
      : photos[kind] || [];
    let next = 0;
    const retry = () => {
      if (next < alternatives.length) {
        img.src = alternatives[next++];
      } else {
        // Kein Motiv aus einem anderen Bildplatz wiederverwenden.
        img.hidden = true;
        const strip = img.closest('.training-simple__photo-strip');
        if (strip && Array.from(strip.querySelectorAll('img')).every(photo => photo.hidden)) {
          strip.setAttribute('hidden', '');
        }
      }
    };
    img.addEventListener('error', retry);
    if (img.complete && img.naturalWidth === 0) retry();
  }
</script>

<style>
  .training-simple{display:grid;gap:18px;color:#1d2c23}
  .training-simple :global(.breadcrumbs){padding-top:0}
  .training-simple__panel{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(270px,.78fr);gap:clamp(20px,3vw,42px);padding:clamp(22px,3vw,44px);background:#fff;border:1px solid #e0e5df;border-radius:16px}
  .training-simple__eyebrow{margin:0 0 8px;font-size:.75rem;letter-spacing:.1em;text-transform:uppercase;color:#c20b19;font-weight:850}
  .training-simple h1{font-size:clamp(2rem,3.4vw,3.7rem);color:#172820;letter-spacing:-.04em;margin:0 0 14px}
  .training-simple__intro{max-width:740px;margin:0 0 27px;color:#526158;line-height:1.62;font-size:1.04rem}
  .training-simple__main h2{font-size:clamp(1.25rem,1.8vw,1.6rem);margin:0 0 14px;letter-spacing:-.02em;color:#1b2e23}
  .training-simple__list{display:grid;gap:11px;padding-left:22px;margin:0 0 27px;color:#43544a;line-height:1.48;font-size:.96rem}
  .training-simple__list li{padding-left:3px}
  .training-simple__list li::marker{color:#e30613}
  .training-simple__list strong{color:#1d2c23}
  .training-simple__links{display:flex;gap:13px 20px;align-items:center;flex-wrap:wrap}
  .training-simple__button{display:inline-flex;align-items:center;gap:20px;justify-content:space-between;text-decoration:none;background:#e30613;color:#fff;font-weight:800;border-radius:8px;padding:13px 17px;min-height:47px}
  .training-simple__button:hover{background:#b90e19}
  .training-simple__text-link{color:#b80817;font-weight:800;text-decoration:none;font-size:.9rem}
  .training-simple__text-link:hover{text-decoration:underline}
  .training-simple__hint{font-size:.81rem;margin:15px 0 0;color:#66756b}
  .training-simple__partner{min-width:0}
  /* Orange der Tennisschule als Partnerfarbe; TSV-Akzente bleiben Rot. */
  .training-simple__brand{display:flex;align-items:center;gap:14px;min-height:118px;padding:12px 16px;background:#f28323;color:#fff;border-radius:10px 10px 0 0;text-decoration:none}
  .training-simple__brand img{width:92px;height:92px;object-fit:contain;flex:0 0 auto}
  .training-simple__brand>span{font-size:.9rem;line-height:1.3}
  .training-simple__brand strong{font-size:1.28rem}
  .training-simple__photos{display:grid;gap:7px;background:#fff6e9;padding:7px;border-radius:0 0 10px 10px}
  .training-simple__photos img{display:block;width:100%;object-fit:cover;background:#ead9c9;border-radius:5px}
  .training-simple__photos img[hidden],.training-simple__photo-strip[hidden]{display:none}
  .training-simple__coach-photo{height:220px;object-fit:cover;object-position:center 20%}
  .training-simple__photo-strip{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:7px}
  .training-simple__photo-strip img{height:112px}
  .training-simple__partner>p{color:#78857b;font-size:.72rem;margin:8px 0 0}
  .training-simple__partner>p a{color:#697b70}
  .training-simple a:focus-visible,.training-simple summary:focus-visible{outline:3px solid #e30613;outline-offset:3px}
  @media(max-width:900px){.training-simple__panel{grid-template-columns:1fr}.training-simple__partner{max-width:630px}.training-simple__coach-photo{height:210px;object-position:center 18%}.training-simple__photo-strip img{height:140px}}
  @media(max-width:600px){.training-simple__panel{padding:21px 17px}.training-simple__intro{font-size:.95rem}.training-simple__list{font-size:.91rem}.training-simple__links{align-items:stretch;flex-direction:column}.training-simple__button{width:100%}.training-simple__brand{min-height:100px}.training-simple__brand img{width:76px;height:76px}.training-simple__coach-photo{height:170px;object-position:center 16%}.training-simple__photo-strip img{height:98px}}
</style>
