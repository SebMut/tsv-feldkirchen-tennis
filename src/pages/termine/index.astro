---
import MainLayout from '../../layouts/MainLayout.astro';
---
<MainLayout title="Tenniskalender | TSV Feldkirchen Tennis" description="Der Tenniskalender des TSV Feldkirchen. Spiele und Vereinsveranstaltungen im Monatskalender – mit direktem Blick auf heute.">
  <div class="container stack club-calendar" id="club-calendar">
    <div class="calendar-page-heading">
      <div>
        <p class="eyebrow">TSV Feldkirchen Tennis</p>
        <h1>Unser Kalender.</h1>
        <p class="muted">Alle Punktspiele und Vereinsevents auf einen Blick. Tippe auf ein Datum, um die Tagesübersicht zu öffnen.</p>
      </div>
      <div class="calendar-heading-today" aria-label="Der Kalender startet mit dem heutigen Datum">
        <span>Dein Startpunkt</span>
        <strong>Heute</strong>
      </div>
    </div>
    <section class="calendar-filter-panel" aria-label="Kalender filtern">
      <div class="calendar-filter-heading"><span>Termine filtern</span><span class="muted">Die Markierungen im Kalender passen sich an.</span></div>
      <div class="phase8-calendar-preferences"><label for="calendar-view">Ansicht</label><select id="calendar-view" aria-label="Kalenderansicht"><option value="month">Monat</option><option value="week">Woche</option></select><label for="calendar-favorite">Lieblingsmannschaft</label><select id="calendar-favorite" aria-label="Lieblingsmannschaft"><option value="">Keine / alle Mannschaften</option></select><button class="button ghost" type="button" id="calendar-save-favorite">Als Favorit speichern</button><span id="calendar-favorite-status" class="muted" role="status"></span></div><div class="filters calendar-filters">
        <select id="calendar-kind" aria-label="Art der Termine"><option value="all">Spiele & Veranstaltungen</option><option value="matches">Nur Punktspiele</option><option value="events">Nur Veranstaltungen</option></select>
        <select id="calendar-range" aria-label="Zeitraum"><option value="all">Alle Zeiträume</option><option value="upcoming">Nur zukünftige</option><option value="year">Aktuelles Kalenderjahr</option><option value="recent">Letzte 90 Tage</option></select>
        <select id="calendar-team" aria-label="Mannschaft wählen"><option value="">Alle Mannschaften</option></select>
        <select id="calendar-category" aria-label="Kategorie wählen"><option value="">Alle Kategorien</option></select>
      </div>
    </section>
    <div id="calendar-data-status" class="calendar-data-status hidden" role="status"></div>
    <div class="calendar-layout">
      <section class="card calendar-board" id="calendar-month-board" aria-labelledby="calendar-month-title">
        <div class="calendar-toolbar">
          <div>
            <p class="eyebrow">Monatsansicht</p>
            <h2 id="calendar-month-title" aria-live="polite">Kalender</h2>
          </div>
          <div class="calendar-controls">
            <button class="calendar-icon-button" id="calendar-prev" type="button" aria-label="Vorheriger Monat" title="Vorheriger Monat">‹</button>
            <button class="calendar-today-button" id="calendar-today" type="button">Heute</button>
            <button class="calendar-icon-button" id="calendar-next" type="button" aria-label="Nächster Monat" title="Nächster Monat">›</button>
          </div>
        </div>
        <p id="calendar-week-range" class="muted hidden" aria-live="polite"></p><div class="calendar-weekdays" aria-hidden="true">
          <span>Mo</span><span>Di</span><span>Mi</span><span>Do</span><span>Fr</span><span>Sa</span><span>So</span>
        </div>
        <div id="calendar-month-grid" class="calendar-month-grid" role="group" aria-label="Tage des Monats"></div>
        <div class="calendar-legend" aria-label="Markierungen im Kalender">
          <span><i class="calendar-legend-dot calendar-legend-dot--men" aria-hidden="true"></i> Herren</span>
          <span><i class="calendar-legend-dot calendar-legend-dot--women" aria-hidden="true"></i> Damen</span>
          <span><i class="calendar-legend-dot calendar-legend-dot--youth" aria-hidden="true"></i> Jugend</span>
          <span><i class="calendar-legend-dot calendar-legend-dot--event" aria-hidden="true"></i> Veranstaltungen</span>
          <span><i class="calendar-legend-today"></i> Heute</span>
        </div>
      </section>
      <aside class="card calendar-agenda" id="calendar-day-agenda" aria-labelledby="calendar-day-heading">
        <div class="calendar-agenda-heading">
          <p class="eyebrow">Ausgewählter Tag</p>
          <h2 id="calendar-day-heading" tabindex="-1">Heute</h2>
          <p id="calendar-day-count" class="muted" aria-live="polite">Termine werden ermittelt …</p>
          <button type="button" id="calendar-back-to-month" class="calendar-back-to-month">↑ Zurück zum Kalender</button>
        </div>
        <div id="calendar-day-list" class="calendar-day-list" aria-live="polite"><p class="muted">Der Kalender wird geladen …</p></div>
        <div class="calendar-agenda-next">
          <h3>Als Nächstes</h3>
          <div id="calendar-next-list" class="calendar-next-list"></div>
        </div>
      </aside>
    </div>
    <dialog id="calendar-day-modal" class="calendar-day-modal" aria-labelledby="calendar-modal-heading" aria-describedby="calendar-modal-count">
      <div class="calendar-day-modal__inner">
        <div class="calendar-day-modal__header">
          <div>
            <p class="eyebrow">Tagesübersicht</p>
            <h2 id="calendar-modal-heading" tabindex="-1">Termine des Tages</h2>
            <p id="calendar-modal-count" class="muted" aria-live="polite">Termine werden geladen …</p>
          </div>
          <button type="button" id="calendar-modal-close" class="calendar-day-modal__close" aria-label="Tagesübersicht schließen" title="Schließen">×</button>
        </div>
        <div id="calendar-modal-list" class="calendar-day-list calendar-day-modal__list">
          <p class="muted">Tagesübersicht wird geladen …</p>
        </div>
        <div class="calendar-day-modal__footer">
          <button type="button" id="calendar-modal-details" class="button">Alle Tagesdetails ansehen</button>
          <button type="button" id="calendar-modal-dismiss" class="button ghost">Schließen</button>
        </div>
      </div>
    </dialog>
    <section class="card calendar-all-section">
      <details id="calendar-all-details">
        <summary>Alle Termine als Liste anzeigen</summary>
        <div id="calendar-list" class="match-list"><p class="muted">Termine werden geladen …</p></div>
      </details>
    </section>
    <section class="card" id="abos">
      <p class="eyebrow">Kalender abonnieren</p>
      <h2>Immer aktuell.</h2>
      <p class="muted">Abonniere die Termine mit Apple Kalender, Outlook oder einer anderen Kalender-App. Das Abonnement bleibt auch bei Änderungen aktualisierbar.</p>
      <div id="calendar-subscriptions" class="actions"><p class="muted">Abo-Links werden geladen …</p></div>
    </section>
  </div>
</MainLayout>
<script>
  import { loadCalendar } from '../../scripts/public';
  loadCalendar();
</script>
