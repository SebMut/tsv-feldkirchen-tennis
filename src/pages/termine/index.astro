---
import MainLayout from '../../layouts/MainLayout.astro';
---
<MainLayout title="Tenniskalender | TSV Feldkirchen Tennis" description="Der Tenniskalender des TSV Feldkirchen. Spiele und Vereinsveranstaltungen im Monatskalender – mit direktem Blick auf heute.">
  <div class="container stack club-calendar" id="club-calendar">
    <div class="calendar-page-heading">
      <div>
        <p class="eyebrow">TSV Feldkirchen Tennis</p>
        <h1>Unser Kalender.</h1>
        <p class="muted">Alle Punktspiele und Vereinsevents auf einen Blick. Tippe auf ein Datum, um die Tagesübersicht zu öffnen.</p>
      </div>
      <div class="calendar-heading-today" aria-label="Der Kalender startet mit dem heutigen Datum">
        <span>Dein Startpunkt</span>
        <strong>Heute</strong>
      </div>
    </div>
    <section class="calendar-filter-panel" aria-label="Kalender filtern">
      <div class="calendar-filter-heading"><span>Termine filtern</span><span class="muted">Die Markierungen im Kalender passen sich an.</span></div>
      <div class="phase8-calendar-preferences">
        <div class="calendar-view-preference">
          <label for="calendar-view">Ansicht</label>
          <select id="calendar-view" aria-label="Kalenderansicht"><option value="month">Monat</option><option value="week">Woche</option></select>
        </div>
        <div class="calendar-favorite-group">
          <label for="calendar-favorite">Lieblingsmannschaft</label>
          <select id="calendar-favorite" aria-label="Lieblingsmannschaft"><option value="">Keine / alle Mannschaften</option></select>
          <label class="calendar-include-events-toggle" for="calendar-include-events"><input id="calendar-include-events" type="checkbox" checked /><span>Veranstaltungen anzeigen</span></label>
        </div>
        <div class="calendar-preference-actions">
          <button class="button ghost" type="button" id="calendar-save-favorite">Favorit speichern</button>
          <a class="calendar-quick-subscribe" href="#abos">Kalender abonnieren <span aria-hidden="true">↓</span></a>
        </div>
        <span id="calendar-favorite-status" class="muted" role="status"></span>
      </div>
      <div class="filters calendar-filters">
        <select id="calendar-kind" aria-label="Art der Termine"><option value="all">Spiele & Veranstaltungen</option><option value="matches">Nur Punktspiele</option><option value="events">Nur Veranstaltungen</option></select>
        <details id="calendar-extra-filters" class="calendar-extra-filters" open>
          <summary>Weitere Filter: Zeitraum, Mannschaft, Kategorie</summary>
          <div class="calendar-extra-filters__grid">
            <select id="calendar-range" aria-label="Zeitraum"><option value="all">Alle Zeiträume</option><option value="upcoming">Nur zukünftige</option><option value="year">Aktuelles Kalenderjahr</option><option value="recent">Letzte 90 Tage</option></select>
            <select id="calendar-team" aria-label="Mannschaft wählen"><option value="">Alle Mannschaften</option></select>
            <select id="calendar-category" aria-label="Kategorie wählen"><option value="">Alle Kategorien</option></select>
          </div>
        </details>
      </div>
      <p id="calendar-active-filter-summary" class="calendar-active-filter-summary" role="status" aria-live="polite">Die Termine werden geladen …</p>
    </section>
    <div id="calendar-data-status" class="calendar-data-status hidden" role="status"></div>
    <div class="calendar-layout">
      <section class="card calendar-board" id="calendar-month-board" aria-labelledby="calendar-month-title">
        <div class="calendar-toolbar">
          <div>
            <p class="eyebrow">Monatsansicht</p>
            <h2 id="calendar-month-title" aria-live="polite">Kalender</h2>
          </div>
          <div class="calendar-controls">
            <button class="calendar-icon-button" id="calendar-prev" type="button" aria-label="Vorheriger Monat" title="Vorheriger Monat">‹</button>
            <button class="calendar-today-button" id="calendar-today" type="button">Heute</button>
            <button class="calendar-icon-button" id="calendar-next" type="button" aria-label="Nächster Monat" title="Nächster Monat">›</button>
          </div>
        </div>
        <p id="calendar-week-range" class="muted hidden" aria-live="polite"></p><div class="calendar-weekdays" aria-hidden="true">
          <span>Mo</span><span>Di</span><span>Mi</span><span>Do</span><span>Fr</span><span>Sa</span><span>So</span>
        </div>
        <div id="calendar-month-grid" class="calendar-month-grid" role="group" aria-label="Tage des Monats"></div>
        <div class="calendar-legend" aria-label="Markierungen im Kalender">
          <span><i class="calendar-legend-dot calendar-legend-dot--men" aria-hidden="true"></i> Herren</span>
          <span><i class="calendar-legend-dot calendar-legend-dot--women" aria-hidden="true"></i> Damen</span>
          <span><i class="calendar-legend-dot calendar-legend-dot--youth" aria-hidden="true"></i> Jugend</span>
          <span><i class="calendar-legend-dot calendar-legend-dot--event" aria-hidden="true"></i> Veranstaltungen</span>
          <span><i class="calendar-legend-today"></i> Heute</span>
        </div>
      </section>
      <aside class="card calendar-agenda" id="calendar-day-agenda" aria-labelledby="calendar-day-heading">
        <div class="calendar-agenda-heading">
          <p class="eyebrow">Ausgewählter Tag</p>
          <h2 id="calendar-day-heading" tabindex="-1">Heute</h2>
          <p id="calendar-day-count" class="muted" aria-live="polite">Termine werden ermittelt …</p>
          <button type="button" id="calendar-back-to-month" class="calendar-back-to-month">↑ Zurück zum Kalender</button>
        </div>
        <div id="calendar-day-list" class="calendar-day-list" aria-live="polite"><p class="muted">Der Kalender wird geladen …</p></div>
        <div class="calendar-agenda-next">
          <h3>Als Nächstes</h3>
          <div id="calendar-next-list" class="calendar-next-list"></div>
        </div>
      </aside>
    </div>
    <dialog id="calendar-day-modal" class="calendar-day-modal" aria-labelledby="calendar-modal-heading" aria-describedby="calendar-modal-count">
      <div class="calendar-day-modal__inner">
        <div class="calendar-day-modal__header">
          <div>
            <p class="eyebrow">Tagesübersicht</p>
            <h2 id="calendar-modal-heading" tabindex="-1">Termine des Tages</h2>
            <p id="calendar-modal-count" class="muted" aria-live="polite">Termine werden geladen …</p>
          </div>
          <button type="button" id="calendar-modal-close" class="calendar-day-modal__close" aria-label="Tagesübersicht schließen" title="Schließen">×</button>
        </div>
        <div id="calendar-modal-list" class="calendar-day-list calendar-day-modal__list">
          <p class="muted">Tagesübersicht wird geladen …</p>
        </div>
        <div class="calendar-day-modal__footer">
          <button type="button" id="calendar-modal-details" class="button">Alle Tagesdetails ansehen</button>
          <button type="button" id="calendar-modal-dismiss" class="button ghost">Schließen</button>
        </div>
      </div>
    </dialog>
    <section class="card calendar-all-section">
      <details id="calendar-all-details">
        <summary>Alle Termine als Liste anzeigen</summary>
        <div id="calendar-list" class="match-list"><p class="muted">Termine werden geladen …</p></div>
      </details>
    </section>
    <section class="card" id="abos">
      <p class="eyebrow">Kalender-Abo in drei Schritten</p>
      <h2>Deine Termine. Automatisch aktuell.</h2>
      <p class="muted">Wähle Mannschaft und Veranstaltungen. Vor dem Abonnieren siehst du, welche bereits veröffentlichten Termine enthalten sind. Neue Termine und Änderungen werden beim nächsten Abruf deiner Kalender-App übernommen.</p>
      <div class="calendar-subscription-builder" aria-label="Kalender-Abo zusammenstellen">
        <div class="calendar-subscribe-step">
          <label for="calendar-subscribe-team"><span class="calendar-subscribe-step__number">1</span> Mannschaft auswählen</label>
          <select id="calendar-subscribe-team"><option value="">Alle Mannschaften</option></select>
          <p class="muted">Du kannst auch nur die Spiele deiner Lieblingsmannschaft abonnieren.</p>
        </div>
        <div class="calendar-subscribe-step">
          <div class="calendar-subscribe-step__label"><span class="calendar-subscribe-step__number">2</span> Veranstaltungen</div>
          <label class="calendar-subscribe-toggle" for="calendar-subscribe-events">
            <input type="checkbox" id="calendar-subscribe-events" checked />
            <span><strong>Vereinsveranstaltungen hinzufügen</strong><small>Zum Beispiel Sommerfest und Platzabbau</small></span>
          </label>
        </div>
        <div class="calendar-subscribe-step calendar-subscribe-step--preview">
          <div class="calendar-subscribe-step__label"><span class="calendar-subscribe-step__number">3</span> Dein Abo im Überblick</div>
          <p id="calendar-subscribe-preview" class="calendar-subscribe-preview" role="status" aria-live="polite">Veröffentlichte Termine werden geladen …</p>
          <ul id="calendar-subscribe-preview-list" class="calendar-subscribe-preview-list" aria-label="Beispiele aus diesem Abo"></ul>
          <p id="calendar-subscribe-note" class="muted">Im Abo sind alle Zeiträume enthalten, auch zukünftige Spielzeiten.</p>
        </div>
      </div>
      <div id="calendar-subscriptions" class="actions calendar-subscribe-actions"><p class="muted">Abo-Links werden geladen …</p></div>
      <p id="calendar-subscription-status" class="muted" role="status" aria-live="polite"></p>
      <p class="muted calendar-subscribe-explainer">Apple Kalender und Outlook öffnen das laufende Abo über <strong>webcal</strong>. Für Google Kalender den HTTPS-Link kopieren und unter <strong>Weitere Kalender → Per URL</strong> einfügen. Wähle <strong>Abonnieren</strong>, nicht „Importieren“.</p>
      <div class="calendar-feed-check">
        <div>
          <h3>Ist mein Abo aktuell?</h3>
          <p class="muted">Prüfe, welche veröffentlichten Termine der TSV-ICS-Feed <strong>für deine derzeitige Auswahl</strong> liefert. Das ist unabhängig vom Abrufrhythmus deiner Kalender-App.</p>
        </div>
        <button type="button" id="calendar-check-feed" class="button secondary">Kalender-Abo prüfen</button>
        <div id="calendar-feed-diagnostic" class="calendar-feed-diagnostic" role="status" aria-live="polite">
          <p class="muted">Noch nicht geprüft. Entwürfe erscheinen nicht in öffentlichen Kalender-Abos.</p>
        </div>
      </div>
      <p class="muted">Die Auswahl oben wird auch für die Kalenderansicht übernommen. Der Zeitraumfilter auf der Kalenderseite begrenzt <strong>nicht</strong> das laufende Abo. Für eine andere Mannschaft oder Veranstaltungsauswahl muss ein bestehendes Abo mit dem neuen Link erneut eingerichtet werden.</p>
      <p class="muted">Wichtig: Der Button „Diesen Termin zu meinem Kalender hinzufügen (.ics)“ ist ein einmaliger Import und aktualisiert sich nicht. Bei echten Abos bestimmt die Kalender-App den Aktualisierungszeitpunkt; Änderungen können verzögert erscheinen.</p>
    </section>
  </div>
</MainLayout>
<script>
  import { loadCalendar } from '../../scripts/public';
  const extraFilters = document.querySelector<HTMLDetailsElement>('#calendar-extra-filters');
  if (extraFilters && window.matchMedia('(max-width: 680px)').matches) extraFilters.open = false;
  loadCalendar();
</script>

<style>

  /* Compact mobile calendar controls and subscription builder. Shared native selects remain the only filter state. */
  .calendar-view-preference{display:grid;gap:6px;min-width:0}
  .calendar-view-preference label{font-size:.83rem;font-weight:800;color:#44554c}
  .calendar-view-preference select{min-width:0;width:100%;border:1px solid #cbd8cd;background:#fff;border-radius:9px;padding:9px;color:#22382b}
  .calendar-preference-actions{display:flex;align-items:center;flex-wrap:wrap;gap:8px;min-width:0}
  .calendar-quick-subscribe{display:inline-flex;align-items:center;gap:6px;min-height:39px;padding:8px 10px;border-radius:9px;color:#a50c19;font-size:.85rem;font-weight:800;text-decoration:none}
  .calendar-quick-subscribe:focus-visible{outline:2px solid #a50c19;outline-offset:2px}
  .calendar-active-filter-summary{margin:9px 0 0;color:#476050;font-size:.82rem;font-weight:700;overflow-wrap:anywhere}
  .calendar-subscription-builder{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin:18px 0 16px;min-width:0}
  .calendar-subscribe-step{display:grid;align-content:start;gap:10px;min-width:0;padding:17px;border:1px solid #dae4db;border-radius:14px;background:#f8faf8}
  .calendar-subscribe-step>label:first-child,.calendar-subscribe-step__label{display:flex;align-items:center;gap:10px;min-width:0;font-size:.93rem;font-weight:850;color:#254034}
  .calendar-subscribe-step__number{display:inline-grid;place-items:center;width:27px;height:27px;flex:none;border-radius:50%;background:#e6f0e8;color:#1b5842;font-weight:900}
  .calendar-subscribe-step>select{width:100%;min-width:0;min-height:44px;border:1px solid #bdcfc3;border-radius:10px;background:#fff;color:#1c392a;padding:9px;font-size:.92rem}
  .calendar-subscribe-step>.muted{font-size:.79rem;margin:0;line-height:1.45}
  .calendar-subscribe-step--preview{grid-column:1/-1;background:#fff}
  .calendar-subscribe-toggle{display:flex;gap:11px;align-items:center;min-height:48px;cursor:pointer;min-width:0}
  .calendar-subscribe-toggle input{width:21px;height:21px;flex:none;margin:0;accent-color:#087884}
  .calendar-subscribe-toggle strong,.calendar-subscribe-toggle small{display:block;line-height:1.35}
  .calendar-subscribe-toggle strong{font-size:.85rem}
  .calendar-subscribe-toggle small{margin-top:3px;color:#61766a;font-size:.76rem}
  .calendar-subscribe-preview{margin:0;font-size:.94rem;font-weight:750;color:#233e2e;line-height:1.5}
  .calendar-subscribe-preview-list{display:grid;gap:7px;margin:0;padding:0;list-style:none}
  .calendar-subscribe-preview-list li{display:flex;align-items:baseline;flex-wrap:wrap;gap:5px 9px;font-size:.84rem;padding:7px 10px;border-radius:9px;background:#f2f7f3}
  .calendar-subscribe-preview-list time{color:#597065;font-variant-numeric:tabular-nums;font-size:.8rem}
  .calendar-subscribe-actions{display:flex;align-items:stretch;gap:9px;flex-wrap:wrap}
  .calendar-subscribe-actions>.button{min-height:44px}
  .calendar-subscription-more{flex:1 1 100%;min-width:0;margin-top:5px}
  .calendar-subscription-more summary{cursor:pointer;min-height:44px;display:flex;align-items:center;font-weight:750;color:#425e4d;font-size:.86rem}
  .calendar-subscription-more .actions{display:flex;flex-wrap:wrap;gap:9px;padding:9px 0}
  .calendar-subscribe-explainer{font-size:.85rem}
  @media(max-width:680px){
    .calendar-page-heading{gap:7px!important;padding-top:0!important}
    .calendar-page-heading h1{font-size:clamp(1.9rem,7.5vw,2.55rem)!important;margin-bottom:2px}
    .calendar-page-heading .muted{font-size:.86rem;line-height:1.45}
    .calendar-heading-today{display:none}
    .calendar-filter-panel{padding:12px;border-radius:12px}
    .calendar-filter-heading{margin-bottom:8px}
    .phase8-calendar-preferences{display:grid;grid-template-columns:90px minmax(0,1fr);gap:8px 10px;padding-bottom:9px;margin-bottom:9px}
    .calendar-view-preference{grid-column:1}
    .phase8-calendar-preferences .calendar-favorite-group{grid-column:2;display:grid;grid-template-columns:1fr;gap:6px}
    .phase8-calendar-preferences .calendar-favorite-group>label:first-child{grid-column:1}
    .phase8-calendar-preferences .calendar-favorite-group>select{grid-column:1}
    .phase8-calendar-preferences .calendar-favorite-group .calendar-include-events-toggle{grid-column:1;gap:7px;min-height:29px;font-size:.77rem;padding:0}
    .calendar-include-events-toggle input{width:17px;height:17px}
    .calendar-preference-actions{grid-column:1/-1;display:grid;grid-template-columns:1fr 1fr;gap:7px}
    .calendar-preference-actions>.button,.calendar-preference-actions>.calendar-quick-subscribe{width:100%;min-height:36px;padding:7px 9px;text-align:center;font-size:.78rem;justify-content:center}
    .phase8-calendar-preferences>#calendar-favorite-status{grid-column:1/-1;font-size:.76rem}
    .calendar-filters>select#calendar-kind{min-height:41px;font-size:.86rem}
    .calendar-filters select{min-height:40px}
    .calendar-board,.calendar-agenda{padding:12px}
    .calendar-toolbar{margin-bottom:7px}
    .calendar-weekdays span{padding:4px 0}
    .calendar-month-grid,.calendar-weekdays{gap:3px}
    .calendar-day{min-height:53px;padding:7px 3px;gap:4px}
    .calendar-day--selected{padding:6px 2px}
    .calendar-legend{padding-top:10px;margin-top:11px;gap:5px 11px;font-size:.69rem}
    .calendar-layout{gap:11px}
    .calendar-agenda-heading{padding-bottom:10px;margin-bottom:10px}
    .calendar-agenda-next{padding-top:12px;margin-top:12px}
    .calendar-subscription-builder{grid-template-columns:1fr;gap:9px;margin:12px 0}
    .calendar-subscribe-step{grid-column:1;padding:13px;gap:8px}
    .calendar-subscribe-actions>.button{width:100%;justify-content:center}
    .calendar-subscription-more .button{width:100%;justify-content:center}
  }
  .calendar-feed-check{display:grid;gap:12px;margin-top:16px;padding:17px;border:1px solid #d5e4d8;border-radius:15px;background:#f8faf8;min-width:0}
  .calendar-feed-check h3{font-size:1.03rem;margin:0 0 6px}
  .calendar-feed-check p{margin:0}
  .calendar-feed-check>.button{justify-self:start}
  .calendar-feed-diagnostic{min-width:0;overflow-wrap:anywhere;font-size:.91rem}
  .calendar-feed-diagnostic__list{margin:12px 0 0;padding-left:20px;display:grid;gap:8px}
  .calendar-feed-diagnostic__list li{padding:0;line-height:1.45}
  .calendar-feed-diagnostic__list span{color:#435e4c}
  @media(max-width:680px){.calendar-feed-check{padding:13px}.calendar-feed-check>.button{width:100%}}
  .calendar-favorite-group{display:grid;grid-template-columns:auto minmax(180px,240px);align-items:center;gap:7px 10px;min-width:0}
  .calendar-favorite-group>label:first-child{font-size:.83rem;font-weight:800;color:#44554c}
  .calendar-favorite-group>select{min-width:0;width:100%;border:1px solid #cbd8cd;background:#fff;border-radius:9px;padding:9px;color:#22382b}
  .phase8-calendar-preferences .calendar-favorite-group .calendar-include-events-toggle{grid-column:1/-1;display:flex;align-items:center;gap:9px;padding:6px 0 1px;font-size:.87rem;font-weight:750;color:#263f31;cursor:pointer;width:max-content;max-width:100%}
  .calendar-include-events-toggle input{width:19px;height:19px;accent-color:#087884;cursor:pointer;margin:0;flex:none}
  .calendar-include-events-toggle:focus-within{outline:2px solid #087884;outline-offset:3px;border-radius:4px}
  @media(max-width:680px){.calendar-favorite-group{grid-column:1/-1;grid-template-columns:minmax(0,1fr) minmax(0,1fr)}.calendar-favorite-group>select{grid-column:2;max-width:none}.calendar-include-events-toggle{grid-column:1/-1}}
  .calendar-extra-filters{grid-column:2 / -1;min-width:0}
  .calendar-extra-filters>summary{display:none}
  .calendar-extra-filters__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}
  @media(max-width:1050px){
    .calendar-extra-filters{grid-column:1 / -1}
  }
  @media(max-width:680px){
    .calendar-filters{grid-template-columns:1fr}
    .calendar-extra-filters{grid-column:auto}
    .calendar-extra-filters>summary{display:list-item;cursor:pointer;font-weight:750;padding:11px 14px;background:#fff;border:1px solid #cdd9d2;border-radius:9px}
    .calendar-extra-filters__grid{margin-top:10px;grid-template-columns:1fr 1fr}
  }
  @media(max-width:390px){
    .calendar-extra-filters__grid{grid-template-columns:1fr}
  }
</style>
