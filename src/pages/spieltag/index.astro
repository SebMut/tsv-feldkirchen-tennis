---
import MainLayout from '../../layouts/MainLayout.astro';
import { mediaUrl } from '../../lib/supabase';
---
<MainLayout
  title="Live-Ticker | TSV Feldkirchen Tennis"
  description="Live-Ticker des TSV Feldkirchen Tennis: laufende Begegnungen, heutige und kommende Punktspiele sowie letzte Ergebnisse."
  headerVariant="light"
  mainClass="main--flush"
>
  <div class="matchday-page matchday-page--ticker" id="home">
    <section class="matchday-hero">
      <div class="container matchday-hero__grid">
        <div>
          <span class="matchday-badge">TSV Feldkirchen Tennis</span>
          <h1>Live-Ticker.<br /><span>Alle Begegnungen.</span></h1>
          <p>Laufende Punktspiele, die nächsten Begegnungen und die letzten Ergebnisse – direkt aus dem Spielbetrieb.</p>
        </div>
        <div class="matchday-hero__mark" aria-hidden="true">
          <img src={mediaUrl("branding/tennis-logo.png")} alt="" width="116" height="116" />
        </div>
      </div>
    </section>

    <div class="container matchday-dashboard">
      <section id="live-center" class="matchday-panel matchday-live-center hidden" aria-live="polite"></section>

      <section id="today-fixtures-panel" class="matchday-panel matchday-today-panel hidden" aria-labelledby="today-fixtures-title">
        <p class="matchday-kicker">Heute</p>
        <h2 id="today-fixtures-title">Heutige Begegnungen</h2>
        <div id="today-matches" class="match-list" aria-live="polite"></div>
      </section>

      <div class="matchday-fixture-grid">
        <section class="matchday-panel" aria-labelledby="upcoming-fixtures-title">
          <p class="matchday-kicker">Demnächst</p>
          <h2 id="upcoming-fixtures-title">Die nächsten Punktspiele</h2>
          <div id="upcoming-matches" class="match-list" aria-live="polite">
            <p class="muted">Weitere Spiele werden geladen …</p>
          </div>
        </section>
        <section class="matchday-panel" aria-labelledby="recent-fixtures-title">
          <p class="matchday-kicker">Ergebnisse</p>
          <h2 id="recent-fixtures-title">Zuletzt gespielt</h2>
          <div id="recent-matches" class="match-list" aria-live="polite">
            <p class="muted">Ergebnisse werden geladen …</p>
          </div>
        </section>
      </div>
    </div>
  </div>
</MainLayout>
<script>
  import { loadHome } from '../../scripts/public';
  loadHome();
</script>
