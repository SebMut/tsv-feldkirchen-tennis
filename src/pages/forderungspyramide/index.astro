---
import MainLayout from '../../layouts/MainLayout.astro';
import '../../styles/pyramid.css';
const isPreview = import.meta.env.PUBLIC_PREVIEW_MODE === 'true';
const pagePath = Astro.url.pathname.replace(/\/+$/, '');
const activeSection = pagePath.endsWith('/so-funktionierts') ? 'rules'
  : pagePath.endsWith('/meine-ranglisten') ? 'ladders'
  : pagePath.endsWith('/mitgliederprofil') ? 'profile'
  : pagePath.endsWith('/meine-verfuegbarkeit') ? 'availability'
  : 'pyramid';
const sectionTitles = {
  pyramid: 'Forderungspyramide',
  rules: 'So funktioniert die Forderungspyramide',
  ladders: 'Meine Ranglisten',
  profile: 'Mitgliederprofil',
  availability: 'Meine Verfügbarkeit',
};
const sectionTitle = sectionTitles[activeSection];
---
<MainLayout title={`${sectionTitle} | TSV Feldkirchen Tennis`} description="Geschützter vereinsinterner Bereich für Forderungsspiele." noindex={true}>
  <div class="container pyramid-page stack" id="pyramid-root">
    <header class="pyramid-heading">
      <div><p class="eyebrow">TSV Feldkirchen Tennis · {isPreview ? 'Testvorschau' : 'Ranglisten'}</p><h1>Forderungspyramide</h1>
        <p>Fordere andere Vereinsmitglieder heraus, vereinbare ein Einzel und kämpfe dich in der vereinsinternen Rangliste nach oben.</p></div>
      {isPreview && <span class="pyramid-stage">Testvorschau</span>}
    </header>

    <section id="pyramid-public-panel" class="card stack" aria-labelledby="pyramid-public-heading">
      <div class="pyramid-section-head"><div><p class="eyebrow">Öffentliche Vereinsrangliste</p>
        <h2 id="pyramid-public-heading">Aktuelle Pyramide</h2>
        <p class="muted">Ohne Anmeldung sind nur Platzierungen und Namen sichtbar. Profilbilder, Abwesenheiten und Forderungen bleiben im geschützten Mitgliederbereich.</p>
      </div></div>
      <div class="field"><label for="pyramid-public-select">Gruppe und Saison</label>
        <select id="pyramid-public-select" aria-label="Öffentliche Pyramide auswählen"></select></div>
      <p id="pyramid-public-dates" class="muted"></p>
      <div id="pyramid-public-board" class="pyramid-board" aria-live="polite">
        <p class="muted">Die öffentliche Rangliste wird geladen …</p>
      </div>
      <p id="pyramid-public-message" class="muted"></p>
    </section>

    <section id="pyramid-auth" class="card pyramid-auth" aria-labelledby="pyramid-login-title">
      <div><p class="eyebrow">Mitglieder und Teilnehmer</p><h2 id="pyramid-login-title">Anmelden</h2>
        <p class="muted">Du verwendest dein vorhandenes Mein-TSV-Konto. Ein neues Konto erhält zunächst keine Ranglistenrechte – die Teilnahme muss freigegeben werden.</p></div>
      <form id="pyramid-login-form" class="form-grid">
        <div class="field"><label for="pyramid-email">E-Mail</label><input id="pyramid-email" type="email" required autocomplete="email" /></div>
        <div class="field"><label for="pyramid-password">Passwort</label><input id="pyramid-password" type="password" autocomplete="current-password" required /></div>
        <div class="field full pyramid-auth-actions">
          <button class="button button--hot" type="submit">Anmelden</button>
          <button class="button ghost" type="button" id="pyramid-magic-link" disabled>Passwort-Link per E-Mail</button>
        </div>
      </form>
      <div id="pyramid-access-turnstile-wrap" class="hidden">
        <div id="pyramid-access-turnstile-widget" aria-label="Cloudflare-Menschprüfung"></div>
        <p id="pyramid-access-turnstile-status" class="muted" role="status">Menschprüfung wird geladen …</p>
      </div>
      <p id="pyramid-access-mail-status" class="muted" role="status" aria-live="polite">Der sichere E-Mail-Versand wird geprüft …</p>
      <p class="muted">Noch kein Zugang oder Passwort vergessen? Gib deine E-Mail-Adresse ein, schließe die Menschprüfung ab und fordere einen einmaligen Link an. Über diesen legst du dein Passwort fest. Einladungen und Freigaben verwaltet der Verein.</p>
    </section>

    <section id="pyramid-password-setup" class="card pyramid-password-setup stack hidden" aria-labelledby="pyramid-password-setup-title">
      <div><p class="eyebrow">Mein TSV · Sicherer Zugang</p>
        <h2 id="pyramid-password-setup-title">Passwort festlegen</h2>
        <p id="pyramid-password-setup-intro" class="muted">Dein Zugangslink wird geprüft …</p></div>
      <form id="pyramid-password-setup-form" class="form-grid hidden">
        <div class="field full"><label for="pyramid-new-password">Neues Passwort (mindestens 10 Zeichen)</label>
          <input id="pyramid-new-password" type="password" minlength="10" maxlength="128" required autocomplete="new-password" /></div>
        <div class="field full"><label for="pyramid-confirm-password">Passwort wiederholen</label>
          <input id="pyramid-confirm-password" type="password" minlength="10" maxlength="128" required autocomplete="new-password" /></div>
        <div class="field full pyramid-auth-actions">
          <button id="pyramid-password-setup-save" class="button button--hot" type="submit">Passwort speichern und zur Pyramide</button>
          <button id="pyramid-password-setup-cancel" class="button ghost hidden" type="button">Abbrechen</button>
        </div>
      </form>
      <p id="pyramid-password-setup-status" class="muted" role="status" aria-live="polite"></p>
    </section>

    <p id="pyramid-status" class="notice hidden" role="status" aria-live="polite"></p>
    <section id="pyramid-app" class="hidden stack" aria-label="Interne Ranglisten">
      <nav class="pyramid-member-nav" aria-label="Bereiche der Forderungspyramide">
        <button id="pyramid-mobile-menu-toggle" class="pyramid-mobile-menu-toggle" type="button" aria-expanded="false" aria-controls="pyramid-member-nav-content">
          <span><small>Ranglisten-Menü</small><strong>{sectionTitle}</strong></span><span class="pyramid-mobile-menu-icon" aria-hidden="true">☰</span>
        </button>
        <div id="pyramid-member-nav-content" class="pyramid-member-nav-links">
          <a href="/forderungspyramide/" aria-current={activeSection === 'pyramid' ? 'page' : undefined}>Pyramide</a>
          <a href="/forderungspyramide/so-funktionierts/" aria-current={activeSection === 'rules' ? 'page' : undefined}>So funktioniert’s</a>
          <a href="/forderungspyramide/meine-ranglisten/" aria-current={activeSection === 'ladders' ? 'page' : undefined}>Meine Ranglisten</a>
          <a href="/forderungspyramide/mitgliederprofil/" aria-current={activeSection === 'profile' ? 'page' : undefined}>Mitgliederprofil</a>
          <a href="/forderungspyramide/meine-verfuegbarkeit/" aria-current={activeSection === 'availability' ? 'page' : undefined}>Meine Verfügbarkeit</a>
        </div>
        <div class="pyramid-session"><span id="pyramid-user-name"></span><button id="pyramid-password-change" class="button ghost" type="button">Passwort ändern</button><button id="pyramid-sign-out" class="button ghost" type="button">Abmelden</button></div>
      </nav>
      <section id="pyramid-upcoming-panel" class:list={["card pyramid-upcoming", { hidden: activeSection !== 'pyramid', "pyramid-section-disabled": activeSection !== 'pyramid' }]} aria-labelledby="pyramid-upcoming-heading">
        <div><p class="eyebrow">Als Nächstes</p><h2 id="pyramid-upcoming-heading">Mein nächstes vereinbartes Spiel</h2></div>
        <div id="pyramid-upcoming-games" aria-live="polite"><p class="muted">Spieltermin wird geladen …</p></div>
      </section>
      <section id="pyramid-rules" class:list={["card pyramid-rules", { hidden: activeSection !== 'rules' }]} aria-labelledby="pyramid-rules-heading">
        <p class="eyebrow">So funktioniert's</p><h2 id="pyramid-rules-heading">Regeln der Forderungspyramide</h2>
        <ul class="pyramid-rules-list">
          <li>Mitspielen dürfen Vereinsmitglieder nach Freigabe. Neue Spieler beginnen auf dem letzten Rang.</li>
          <li>Fordern darfst du links in der eigenen Reihe und rechts oben in der nächsten Reihe; für Platz 3 gilt auch Platz 1. Die verbindliche Beispieltabelle regelt Sonderfälle.</li>
          <li>Der Herausforderer schlägt den Spieltermin vor. Der Geforderte muss ihn ausdrücklich akzeptieren. Der Termin sollte möglichst innerhalb von drei Tagen feststehen; das Match muss innerhalb von <strong>14 Tagen</strong> stattfinden.</li>
          <li>Gespielt werden <strong>zwei Gewinnsätze</strong>. Der dritte Satz ist ein Match-Tie-Break bis mindestens 10 Punkte mit 2 Punkten Abstand.</li>
          <li>Der Herausforderer organisiert den Platz und stellt die Bälle.</li>
          <li>Pro Spieler ist nur <strong>eine offene Forderung</strong> zulässig.</li>
          <li>Der Sieger meldet das Ergebnis, der Gegner bestätigt es innerhalb von <strong>48 Stunden</strong>. Bei Streit entscheidet der Ranglistenwart.</li>
          <li>Nach einer Niederlage und vor einer erneuten Forderung desselben Gegners gelten <strong>7 Tage Wartezeit</strong>. Der Sieger ist <strong>48 Stunden</strong> gegen neue Forderungen geschützt.</li>
          <li>Bei Fristüberschreitung, Nichtantreten nach 15 Minuten oder schlechtem Wetter entscheidet die Ranglistenverwaltung. Eine Wetterverlängerung ist einmalig um bis zu 7 Tage möglich.</li>
          <li>Urlaub, Krankheit oder Verletzung können bis zu <strong>28 Tage</strong> neutralisiert werden. Danach wirst du ans Ende deiner aktuellen Reihe gesetzt. Stehst du dort bereits, wechselst du in die Mitte der nächsten Reihe.</li>
        </ul>
        <p class="muted pyramid-rules-foot">Saisonstandard: 1. Mai bis 30. September. Es gilt das Master-Regelwerk der Forderungspyramide, Version 1.0.</p>
      </section>
      <div id="pyramid-ladders" class:list={["pyramid-toolbar card", { hidden: activeSection !== 'ladders' }]}>
        <div><p class="eyebrow">Meine Ranglisten</p><label for="pyramid-ladder-select" class="pyramid-toolbar-label">Saison und Gruppe</label>
          <select id="pyramid-ladder-select" aria-label="Rangliste auswählen"></select></div>
      </div>
      <section id="pyramid-join-panel" class:list={["card hidden", { "pyramid-section-disabled": activeSection !== 'ladders' }]}>
        <p class="eyebrow">Teilnahme</p><h2>Für diese Pyramide bewerben</h2>
        <p>Du bist angemeldet. Wähle oben die gewünschte Gruppe und stelle hier deine Anfrage. Die Ranglistenverwaltung gibt deine Teilnahme anschließend frei.</p>
        <form id="pyramid-join-form" class="form-grid">
          <div class="field"><label for="pyramid-display-name">Name für die Rangliste</label><input id="pyramid-display-name" maxlength="80" minlength="2" required autocomplete="name" /></div>
          <div class="field pyramid-form-end"><button class="button button--hot" type="submit">Jetzt Teilnahme beantragen</button></div>
        </form>
        <p id="pyramid-join-state" class="muted"></p>
      </section>
      <section id="pyramid-avatar-panel" class:list={["card stack hidden", { "pyramid-section-disabled": activeSection !== 'profile' }]}>
        <div><p class="eyebrow">Mitgliederprofil</p><h2>Mein Profilbild</h2>
          <p class="muted">Dein Foto erscheint oben links auf deiner Spieler-Kachel in der Forderungspyramide. Es ist für angemeldete, berechtigte Ranglistenmitglieder sichtbar. Beim Auswählen wird dein Bild sofort angezeigt und automatisch gespeichert. Erlaubt sind JPG, PNG, WebP und AVIF bis 8 MB.</p>
        </div>
        <div class="pyramid-avatar-editor">
          <div id="pyramid-avatar-preview" aria-live="polite"></div>
          <div class="stack">
            <form id="pyramid-avatar-form" class="form-grid">
              <div class="field full"><label for="pyramid-avatar-file">Profilbild auswählen</label>
                <input id="pyramid-avatar-file" type="file" accept="image/jpeg,image/png,image/webp,image/avif" required /></div>
              <div class="field full"><p id="pyramid-avatar-save-state" class="muted" role="status" aria-live="polite">Nach der Bildauswahl wird es sofort angezeigt und automatisch gespeichert.</p></div>
            </form>
            <button id="pyramid-avatar-remove" type="button" class="button ghost">Profilbild entfernen</button>
          </div>
        </div>
      </section>
      <section id="pyramid-account-delete-panel" class:list={["card stack hidden", { "pyramid-section-disabled": activeSection !== 'profile' }]}>
        <div><p class="eyebrow">Forderungspyramidenkonto</p><h2>Konto aus der Pyramide löschen</h2>
          <p>Du wirst aus der ausgewählten Forderungspyramide entfernt und dein Platz wird sofort frei. Alle nachfolgenden Mitglieder rücken einen Platz nach oben.</p>
          <p class="muted">Abgeschlossene Ergebnisse bleiben für deine jeweiligen Gegner sichtbar und für die Rangliste relevant. Offene Forderungen werden beendet. Dein allgemeines Mein-TSV-Benutzerkonto bleibt bestehen. Dieser Schritt kann nicht selbst rückgängig gemacht werden.</p>
        </div>
        <div><button id="pyramid-account-delete" type="button" class="button danger">Forderungspyramidenkonto löschen</button></div>
      </section>
      <section id="pyramid-overview" class:list={["card stack", { hidden: activeSection !== 'pyramid' }]}>
        <div class="pyramid-section-head"><div><p class="eyebrow">Rangliste</p><h2 id="pyramid-ladder-heading">Pyramide</h2>
          <p id="pyramid-ladder-dates" class="muted"></p></div><span id="pyramid-own-rank" class="pyramid-own-rank"></span></div>
        <div id="pyramid-board" class="pyramid-board" aria-live="polite"></div>
        <div id="pyramid-qualifier" aria-live="polite"></div>
        <p class="muted pyramid-board-help">Innerhalb der eigenen Reihe nach links oder eine Reihe höher nach rechts fordern. Ab Rang 3 aufwärts ist Rang 1 erreichbar. Neue Mitglieder werden am Ende eingereiht.</p>
      </section>
      <details id="pyramid-availability-panel" class:list={["card pyramid-availability hidden", { "pyramid-section-disabled": activeSection !== 'availability' }]} open={activeSection === 'availability'}>
        <summary><span><span class="eyebrow">Meine Verfügbarkeit</span><strong>Spielbereit oder neutralisiert?</strong></span><span aria-hidden="true">⌄</span></summary>
        <div class="pyramid-availability-content stack">
          <p class="muted">Du kannst deine Spieler-Kachel bei Urlaub, Krankheit, Verletzung oder sonstiger Abwesenheit höchstens 28 Tage neutralisieren. Währenddessen sind Forderungen gesperrt. Danach wirst du automatisch wieder spielbereit und ans Ende deiner aktuellen Reihe gesetzt. Stehst du dort bereits, wechselst du in die Mitte der nächsten Reihe.</p>
          <form id="pyramid-availability-form" class="form-grid">
            <div class="field"><label for="pyramid-neutral-reason">Status</label>
              <select id="pyramid-neutral-reason">
                <option value="">Spielbereit</option>
                <option value="vacation">Urlaub (maximal 28 Tage)</option>
                <option value="illness">Krankheit</option>
                <option value="injury">Verletzung</option>
                <option value="other">Sonstige Abwesenheit</option>
              </select>
            </div>
            <div class="field pyramid-form-end"><button type="submit" class="button secondary">Status speichern</button></div>
          </form>
          <p class="muted" id="pyramid-neutral-state" aria-live="polite"></p>
        </div>
      </details>
      <section id="pyramid-games-panel" class:list={["card stack", { hidden: activeSection !== 'pyramid', "pyramid-section-disabled": activeSection !== 'pyramid' }]}>
        <div class="pyramid-section-head"><div><p class="eyebrow">Forderungsspiele</p><h2>Offene und letzte Begegnungen</h2></div></div>
        <div id="pyramid-games" class="pyramid-games" aria-live="polite"></div>
      </section>
      <section id="pyramid-admin-panel" class:list={["card stack hidden", { "pyramid-section-disabled": activeSection !== 'ladders' }]}>
        <div><p class="eyebrow">Nur Ranglistenverwaltung</p><h2>Ranglistenverwaltung</h2>
          <p class="muted">Saisons und Gruppen werden separat verwaltet. Bereits vorhandene Mannschaftskader bleiben unverändert.</p></div>
        <form id="pyramid-create-form" class="pyramid-create-form">
          <div class="field"><label for="pyramid-new-name">Rangliste</label><input id="pyramid-new-name" placeholder="z. B. Damen" minlength="3" required /></div>
          <div class="field"><label for="pyramid-new-season">Saison</label><input id="pyramid-new-season" placeholder="z. B. Sommer 2027" minlength="3" required /></div>
          <div class="field"><label for="pyramid-new-start">Start</label><input id="pyramid-new-start" type="date" required /></div>
          <div class="field"><label for="pyramid-new-end">Ende</label><input id="pyramid-new-end" type="date" required /></div>
          <button class="button button--hot" type="submit">Rangliste anlegen</button>
        </form>
        <h3>Offene Teilnahmeanfragen</h3>
        <div id="pyramid-admin-requests"></div>
        <h3>Startplätze sortieren</h3>
        <div id="pyramid-admin-entries" class="pyramid-admin-entries"></div>
        <button class="button secondary" id="pyramid-finalize-seed" type="button">Startaufstellung verbindlich abschließen</button>
        <p class="muted">Die LK-Startsortierung wird im <a href="/admin/">Mein-TSV-Adminbereich</a> verwaltet. Später freigegebene Mitglieder werden automatisch auf dem letzten Rang aufgenommen.</p>
      </section>
    </section>
  </div>
  <dialog id="pyramid-schedule-dialog" class="pyramid-dialog" aria-labelledby="pyramid-schedule-title">
    <div class="pyramid-dialog-content">
      <div class="pyramid-dialog-top"><h2 id="pyramid-schedule-title">Verbindlichen Spieltermin eintragen</h2>
        <button id="pyramid-schedule-close" class="pyramid-dialog-close" aria-label="Termin-Dialog schließen" type="button">✕</button></div>
      <p class="muted">Nur der Herausforderer trägt den abgestimmten Termin ein oder ändert ihn. Der Geforderte muss den Vorschlag anschließend ausdrücklich akzeptieren. Das Match muss spätestens 14 Tage nach der ursprünglichen Forderung gespielt werden.</p>
      <form id="pyramid-schedule-form" class="form-grid">
        <div class="field full"><label for="pyramid-schedule-date">Vereinbarter Spieltermin</label><input id="pyramid-schedule-date" type="datetime-local" required /></div>
        <p id="pyramid-schedule-error" class="pyramid-modal-message hidden" role="alert" aria-live="assertive"></p>
        <div class="field full pyramid-dialog-actions"><button class="button button--hot" type="submit">Termin vorschlagen</button>
          <button id="pyramid-schedule-cancel" class="button ghost" type="button">Abbrechen</button></div>
      </form>
    </div>
  </dialog>
  <dialog id="pyramid-lk-dialog" class="pyramid-dialog" aria-labelledby="pyramid-lk-title">
    <form id="pyramid-lk-form" class="pyramid-dialog-content">
      <div class="pyramid-dialog-top"><div><p class="eyebrow">Einmalige Angabe</p><h2 id="pyramid-lk-title">Bitte trage deine aktuelle LK ein</h2></div></div>
      <p>Für eine faire Startaufstellung benötigen wir einmalig deine aktuelle Leistungsklasse.</p>
      <p class="pyramid-modal-message"><strong>Bitte trage wahrheitsgemäß deine tatsächliche LK ein.</strong> Nach dem Speichern kannst du den Wert nicht selbst ändern. Eine spätere Korrektur ist nur durch den Superadmin möglich.</p>
      <div class="field"><label for="pyramid-own-lk">Meine aktuelle LK</label><input id="pyramid-own-lk" type="number" min="1" max="25" step="0.1" inputmode="decimal" placeholder="z. B. 12,5" required /></div>
      <p id="pyramid-lk-error" class="pyramid-modal-message hidden" role="alert" aria-live="assertive"></p>
      <div class="pyramid-dialog-actions"><button class="button button--hot" type="submit">LK verbindlich speichern</button></div>
    </form>
  </dialog>
  <dialog id="pyramid-dialog" class="pyramid-dialog" aria-labelledby="pyramid-dialog-title">
    <form id="pyramid-result-form" method="dialog" class="pyramid-dialog-content pyramid-result-wizard">
      <div class="pyramid-dialog-top"><div><p class="eyebrow">Forderungsspiel · Ergebnis</p><h2 id="pyramid-dialog-title">1. Satz auswählen</h2></div>
        <button type="button" id="pyramid-dialog-close" class="pyramid-dialog-close" aria-label="Schließen">✕</button></div>
      <p id="pyramid-dialog-opponents" class="muted"></p>
      <div id="pyramid-result-sets" class="pyramid-result-sets" aria-live="polite"></div>
      <section id="pyramid-result-set-entry" class="pyramid-result-set-entry" aria-labelledby="pyramid-result-entry-heading">
        <div class="pyramid-result-entry-head"><strong id="pyramid-result-entry-heading">Eigenen Satzstand eingeben</strong><span id="pyramid-result-example">z. B. 6:4</span></div>
        <p id="pyramid-result-help" class="muted">Wähle einen fertigen Satzstand oder gib einen eigenen gültigen Endstand ein.</p>
        <div class="pyramid-result-score-inputs">
          <label>Sieger<input id="pyramid-result-own-games" type="number" min="0" max="99" inputmode="numeric" value="6" /></label>
          <strong aria-hidden="true">:</strong>
          <label>Gegner<input id="pyramid-result-opponent-games" type="number" min="0" max="99" inputmode="numeric" value="0" /></label>
        </div>
        <button id="pyramid-result-custom-save" class="button button--hot" type="button">Satz übernehmen</button>
      </section>
      <div><p class="pyramid-result-quick-label">Schnellauswahl fertiger Satzstände</p><div id="pyramid-result-quick" class="pyramid-result-quick"></div></div>
      <input id="pyramid-result-score" type="hidden" />
      <div class="field hidden" id="pyramid-winner-field"><label for="pyramid-result-winner">Sieger (Ranglistenverwaltung)</label><select id="pyramid-result-winner"></select></div>
      <p id="pyramid-result-error" class="pyramid-modal-message hidden" role="alert" aria-live="assertive"></p>
      <p class="muted">Das Ergebnis wird dem Gegner zur Bestätigung vorgelegt. Bis dahin bleibt die Rangfolge unverändert.</p>
      <div class="pyramid-dialog-actions"><button id="pyramid-result-undo" class="button ghost hidden" type="button">Letzten Satz ändern</button><button id="pyramid-result-submit" class="button button--hot hidden" type="submit">Ergebnis zur Bestätigung melden</button>
        <button class="button ghost" id="pyramid-dialog-cancel" type="button">Abbrechen</button></div>
    </form>
  </dialog>
</MainLayout>
<script>
  import { initPyramid } from '../../scripts/pyramid';
  initPyramid();
</script>
