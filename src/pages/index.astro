---
import MainLayout from '../layouts/MainLayout.astro';
import { COURTBOOKING_URL } from '../lib/supabase';
---
<MainLayout
  title="TSV Feldkirchen Tennis"
  description="Tennis beim TSV Feldkirchen: Mannschaften, Spieltage, Liveticker, Termine und Platzbuchung."
  mainClass="main--flush"
>
  <section class="premium-hero">
    <img class="premium-hero__photo" src={`${import.meta.env.BASE_URL}images/tsv-feldkirchen-tennisanlage-hero.avif`} alt="" aria-hidden="true" width="1200" height="900" loading="eager" fetchpriority="high" decoding="async" />
    <div class="container premium-hero__inner">
      <p class="eyebrow">Tennis TSV Feldkirchen</p>
      <a id="facility-pill" class="facility-pill facility-pill--unknown" href="https://tsvfeldkirchen.courtbooking.de/login.php" target="_blank" rel="noreferrer" aria-live="polite">Anlagenstatus wird geladen …</a>
      <h1>Tennis.<br />Teams.<br /><span>Gemeinschaft.</span></h1>
      <p class="premium-hero__lead">Sportlich ambitioniert, familiär im Club und digital am Spieltag. Alles rund um Mannschaften, Termine und Vereinsleben an einem Ort.</p>
      <div class="actions">
        <a class="button button--hot" href={COURTBOOKING_URL} target="_blank" rel="noreferrer">Platz buchen</a>
        <a class="button button--outline" href="/mitglied-werden/">Mitglied werden</a>
        <a class="button button--outline" href="/spieltag/">Zum Spieltag</a>
      </div>
    </div>
  </section>

  <section class="premium-metrics" aria-label="Vereinskennzahlen">
    <div><strong id="home-court-count" data-count-only="true">8</strong><span>Sandplätze</span></div>
    <div><strong>329</strong><span>Mitglieder</span></div>
    <div><strong id="home-team-count" data-count-only="true">20</strong><span>Mannschaften</span></div>
    <div><strong>LIVE</strong><span>digitaler Spieltag</span></div>
  </section>

  <div class="container premium-content" id="home">
    <section id="live-center" class="card live-center hidden premium-live" aria-live="polite"></section>

    <section class="card home-welcome">
      <p class="eyebrow">Herzlich willkommen</p>
      <h2>Das ist die Seite der Tennisabteilung des TSV Feldkirchen!</h2>
      <p><strong>Willkommen bei Tennis TSV Feldkirchen – Ihrem Ziel für alle Dinge Rennsport und Einzelsportarten.</strong></p>
      <p>Herzlich willkommen bei der Tennisabteilung des <strong>TSV Feldkirchen bei München</strong>! Mit rund <strong>329 Mitgliedern</strong> und <strong>20 Mannschaften</strong> bieten wir Tennis für alle Alters- und Spielklassen – von der Jugend über Damen und Herren bis zu Freizeitspielern.</p>
      <p>Auf unserer Anlage stehen <strong>Sport, Gemeinschaft und Spaß am Tennis</strong> im Mittelpunkt. Schau dich gerne auf unserer Seite um und erfahre mehr über unsere <strong>Mannschaften, Termine und Veranstaltungen</strong>. <strong>Wir freuen uns auf dich – komm vorbei und spiel mit!</strong></p>
    </section>

    <section class="card home-weather" aria-labelledby="weather-title">
      <div><p class="eyebrow">Feldkirchen bei München</p><h2 id="weather-title">Tenniswetter</h2></div>
      <div id="home-weather" class="weather-grid"><p class="muted">Wetter wird geladen …</p></div>
    </section>

    <section class="home-columns">
      <article class="card home-news-column">
        <p class="eyebrow">Aktuelles</p><h2>News aus dem Verein</h2>
        <div id="home-news" class="news-list"><p class="muted">Aktuelle Beiträge werden ermittelt …</p></div>
        <p><a class="text-link" href="/aktuelles/">Alle Nachrichten →</a></p>
      </article>
      <article class="card home-games-column">
        <p class="eyebrow">Spieltag</p><h2>Kommende Spiele</h2>
        <div id="today-matches" class="match-list"><p class="muted">Die nächsten Punktspiele werden ermittelt …</p></div>
        <p><a class="text-link" href="/spieltag/">Spieltagszentrale öffnen →</a></p>
      </article>
    </section>

    <section class="card phase8-install" id="phase8-install" aria-label="TSV Tennis als App installieren">
      <div><p class="eyebrow">TSV auf dem Smartphone</p><h2>Die Tennis-Homepage als App</h2>
      <p class="muted" data-install-hint>Du kannst diese Website über die Teilen-Funktion deines Browsers zum Home-Bildschirm hinzufügen. Auf unterstützten Android-Browsern erscheint zusätzlich eine Installationsschaltfläche.</p></div>
      <button class="button secondary" type="button" data-install-app hidden>TSV Tennis installieren</button>
    </section>
    <section id="home-sponsors" class="hidden" aria-label="Sponsoren"></section>
  </div>
</MainLayout>
<script>
  import { loadHome } from '../scripts/public';
  import { initInstallPrompt } from '../scripts/phase8';
  loadHome();
  initInstallPrompt();
</script>
