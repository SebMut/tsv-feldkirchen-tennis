---
import MainLayout from '../../layouts/MainLayout.astro';
---
<MainLayout
  title="Liveticker | TSV Feldkirchen Tennis"
  description="Live vom Spieltag beim TSV Feldkirchen Tennis."
  headerVariant="light"
  mainClass="main--flush"
>
  <div class="matchday-page live-page-refresh">
    <section class="matchday-hero matchday-hero--compact">
      <div class="container">
        <span class="matchday-badge">TENNIS · TSV FELDKIRCHEN</span>
        <div id="live-match-head"><p role="status">Spieltag wird geladen …</p></div>
      </div>
    </section>

    <div class="container matchday-dashboard">
      <section class="matchday-panel matchday-live-panel">
        <div id="live-score" aria-live="polite" aria-atomic="true"></div>
        <div id="live-encounters" class="live-encounters"></div>
        <div class="live-timeline-section">
          <div class="page-head">
            <div><p class="matchday-kicker">Vom Spielfeld</p><h2>Live-Meldungen</h2></div>
          </div>
          <div id="live-timeline" class="timeline"></div>
        </div>
      </section>
      <section id="live-sponsor" class="hidden" aria-label="Sponsor des Spieltags"></section>
      <p><a class="matchday-action" href="/spieltag/">← Zur Spieltagszentrale</a></p>
    </div>
  </div>
</MainLayout>
<script>
  import { loadLiveTicker } from '../../scripts/public';
  const matchId = new URLSearchParams(location.search).get('match');
  loadLiveTicker(matchId);
</script>
