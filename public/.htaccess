RewriteEngine On

# Alte WordPress-Hauptseiten
Redirect 301 /front_page/ /
Redirect 301 /herrenmannschaften/ /mannschaften/
Redirect 301 /damenmannschaften/ /mannschaften/
Redirect 301 /jugendmannschaften/ /mannschaften/
Redirect 301 /spielplaene/ /termine/
Redirect 301 /kalender-downloaden/ /termine/#abos
Redirect 301 /unterstuetzer/ /sponsoren/
Redirect 301 /ueber-uns/ /funktionaere/
Redirect 301 /impressum/ https://tsvfeldkirchen.de/impressum
Redirect 301 /datenschutz/ https://tsvfeldkirchen.de/datenschutz-dsgvo

# Alte redaktionelle Beiträge
Redirect 301 /schnuppertag/ /aktuelles/
Redirect 301 /kalender-fuer-alle-mannschaften/ /termine/#abos
Redirect 301 /aufbau-der-plaetze/ /aktuelles/
RedirectMatch 301 ^/jahreshauptversammlung-fuer-die-geschaeftsjahre-2024-und-2025.*$ /aktuelles/

# The Events Calendar: einzelne alte Terminseiten auf die neue Terminübersicht
RewriteRule ^termine/.+$ /termine/ [R=301,L,NE]

# Alte automatisch erzeugte Punktspiel-Beiträge
RewriteRule ^(herren|damen|junioren-18|knaben-15|maedchen-15|bambini-12|kleinfeld-u9|u9).*(heimspiel|auswaertsspiel)-gegen-.*$ /termine/ [R=301,L,NE]

# Alte Mannschaftskalender werden auf die neuen Supabase-ICS-Feeds umgeleitet
RewriteRule ^mannschaft-kalender/alle-mannschaften-2026\.ics$ https://eaurnufdochjapfzqwvm.supabase.co/functions/v1/calendar-feed?type=matches [R=301,L,NE]
RewriteRule ^mannschaft-kalender/([^/]+)\.ics$ https://eaurnufdochjapfzqwvm.supabase.co/functions/v1/calendar-feed?type=matches&team=$1 [R=301,L,NE]

Options -Indexes
